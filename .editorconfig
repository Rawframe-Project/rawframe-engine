root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,yaml,yml}]
indent_style = space
indent_size = 2

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,inl,ipp,luau,lua,cmake}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

[CMakeLists.txt]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

[*.{bat,cmd}]
end_of_line = crlf
