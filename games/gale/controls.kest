module controls

// What a player asks of its ship (D681): its throttle, from half astern
// (-0.5) to full ahead (1), where its player last set it, and its rudder,
// from hard to port (-1) to hard to starboard (1); and whether it fires its
// guns to port or to starboard (D683).
struct Helm {
    throttle: f32
    rudder: f32
    port: bool
    starboard: bool
}
