module ledges

// The sample tile game: players are balls that roll and hop about a level
// whose solid tiles are one static body. The systems here only make
// players and push them.

import rawframe.physics2d
import rawframe.random
import rawframe.spline
import rawframe.world

// The balls' collision class (ledges.game): balls roll through each other.
const BALL: u64 = 0x6e5c9a7569ee0ec9

// What a player asks for: -1 to 1 along each axis.
struct Steer {
    dx: f32
    dy: f32
}

// A player's entity arrives with its components zeroed: here it becomes a
// ball dropped somewhere over the level, below its top row.
fn join(count: i32, bodies: [physics2d.Body2D], poses: [physics2d.Pose2D]) {
    let i = 0
    while i < count {
        if bodies[i].width == 0.0 {
            bodies[i] = physics2d.Body2D(physics2d.DYNAMIC, physics2d.CIRCLE, false, false, false, BALL, 0.4,
                                         0.0, 1.0, 0.8, 0.1, 0.2, 0.5)
            poses[i] = physics2d.Pose2D(random.unit(0) * 50.0 - 25.0, 10.5, 1.0, 0.0)
        }
        i = i + 1
    }
}

// Rolling along, and a hop when asked hard enough while touching something
// to push off.
fn push(count: i32, steers: [Steer], impulses: [physics2d.Impulse2D], contacts: [physics2d.Contact2D]) {
    let i = 0
    while i < count {
        impulses[i].x = steers[i].dx * 0.05
        if steers[i].dy > 0.8 && contacts[i].touching > 0 {
            impulses[i].y = 2.0
        }
        i = i + 1
    }
}

// A lift's ride: the spline it follows and how far along it is.
struct Ride {
    spline: world.Entity
    meters: f64
}

// Meters a second along its path.
const LIFT_SPEED: f64 = 2.0

// A lift rides its spline: each tick a little further along it, its
// kinematic body carried there by the physics step, pushing what it meets.
fn lift(count: i32, rides: [Ride], targets: [physics2d.Target2D]) {
    let i = 0
    while i < count {
        rides[i].meters = rides[i].meters + LIFT_SPEED / f64(60.0)
        let at = spline.along(rides[i].spline, rides[i].meters)
        if at.found {
            targets[i] = physics2d.Target2D(at.x, at.y, 1.0, 0.0, true)
        }
        i = i + 1
    }
}

// The spline types the game's path and points are, which the engine reads
// and measures; a program lays out only the types it names.
fn path(paths: [spline.Spline], points: [spline.Point]) {
}
