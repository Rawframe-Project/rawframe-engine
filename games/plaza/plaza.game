# The sample 3D game: players are characters running and jumping about a
# square plaza with a ramp, a raised terrace, pillars, a grassy mound
# modeled in an authoring tool, a gate on a hinge, and a swinging blade,
# all of it Maul3D.
# A client predicts its own character exactly, is sent what is within 30
# meters on the ground plane, and sees the others between states.
program plaza.kest
physics3d gravity 0 -10 0

collision class walker 5f23859a6c00ebba

# The mound's triangles, cooked from glTF (the plaza is played with its
# cooked content).
mesh 6d3cbd2231e069f1 mound.gltf

component 43f8c60f-1131-4732-8bed-d758dc5b5fa7 plaza.stick Stick
component 9b8e1f52-3c47-4d0a-a6e2-5f1d7c93b204 plaza.blade Blade
component 2d6e0b91-7c35-4f48-9a1e-3b5c8d0f6a27 plaza.stroller Stroller

# The blade's swing: its skeleton and clip under blade/, played on the
# server too, since the blade's body follows its bone.
animator 3a7d1f0c2b9e4d61 blade.rfanim

# The strollers' locomotion under stroll/: idle, walk, and run on a blend
# space by pace, synced by phase, moving them by root motion, their heads
# turned by a look-at the server runs too.
animator 5c7e2a91f04b3d68 stroll.rfanim parameters plaza.stroller

system plaza.join simulation join write rawframe.physics3d.body write rawframe.physics3d.pose write rawframe.physics3d.character with plaza.stick random spawn before rawframe.physics3d.step
system plaza.swing simulation swing read plaza.blade write rawframe.physics3d.target entities after rawframe.animation.step before rawframe.physics3d.step
system plaza.stroll simulation stroll write plaza.stroller read rawframe.animation.root_motion entities after rawframe.animation.step
system plaza.walk simulation walk read plaza.stick read rawframe.physics3d.character write rawframe.physics3d.velocity before rawframe.physics3d.step predicted

# The plaza, eighty meters square, and walls around it.
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=40 height=0.5 depth=40 rawframe.physics3d.pose rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=0.5 height=5 depth=40 rawframe.physics3d.pose x=-40 y=5 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=0.5 height=5 depth=40 rawframe.physics3d.pose x=40 y=5 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=40 height=5 depth=0.5 rawframe.physics3d.pose z=-40 y=5 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=40 height=5 depth=0.5 rawframe.physics3d.pose z=40 y=5 rawframe.physics3d.velocity

# A terrace 2.7 meters up, a ramp of 20 degrees rising to it along x, and
# pillars.
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=6 height=1.37 depth=6 rawframe.physics3d.pose x=24 y=1.87 z=0 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=4 height=0.5 depth=3 rawframe.physics3d.pose x=14.4 y=1.4 qz=0.1736 qw=0.9848 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=3 width=1 height=3 rawframe.physics3d.pose x=-10 y=3.5 z=-10 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=3 width=1 height=3 rawframe.physics3d.pose x=10 y=3.5 z=-10 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=3 width=1 height=3 rawframe.physics3d.pose x=-10 y=3.5 z=10 rawframe.physics3d.velocity

# A gate in the far corner, hung on its post by a hinge that turns about
# the post.
scene gate.scene

# A blade hung from a pivot four meters up in the corner opposite the
# gate, swinging a quarter turn and back every two seconds at a
# walker's height: a kinematic box carried to the animated bone's pose
# each step, so it pushes what it meets.
spawn 1 plaza.blade pivotX=30 pivotY=4 pivotZ=30 rawframe.animation.animator graph=blade.rfanim relevance=1 rawframe.physics3d.body motion=1 shape=1 width=0.1 height=0.5 depth=0.8 rawframe.physics3d.pose x=30 y=1 z=30 rawframe.physics3d.velocity rawframe.physics3d.target

# The mound, ten meters across and 1.2 high, on the plaza's floor.
spawn 1 rawframe.physics3d.body motion=0 shape=4 rawframe.physics3d.pose x=-20 y=0.5 z=20 rawframe.physics3d.velocity rawframe.physics3d.mesh mesh=mound.gltf

# Eight strollers about the plaza, each starting its pace at another time.
spawn 1 plaza.stroller x=-12 z=-4 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller x=-6 z=12 clock=30 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller x=4 z=-14 clock=60 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller x=12 z=6 clock=90 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller x=-18 z=8 clock=120 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller x=18 z=-8 clock=150 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller x=0 z=18 clock=180 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller x=-2 z=-20 clock=210 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion

replicate plaza.stroller rawframe.physics3d.body rawframe.physics3d.pose rawframe.physics3d.velocity rawframe.physics3d.character plaza.stick
player plaza.stick rawframe.physics3d.body rawframe.physics3d.pose rawframe.physics3d.velocity rawframe.physics3d.character
input plaza.stick
interest rawframe.physics3d.pose x z within 30
interpolate rawframe.physics3d.pose
predict rawframe.physics3d.body rawframe.physics3d.pose rawframe.physics3d.velocity rawframe.physics3d.character plaza.stick
