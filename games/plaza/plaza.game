# The sample 3D game: players are characters running and jumping about a
# square plaza with a ramp, a raised terrace, pillars, a grassy mound
# modeled in an authoring tool, a gate on a hinge, and a swinging blade,
# all of it Maul3D.
# A client predicts its own character exactly, is sent what is within 30
# meters on the ground plane, and sees the others between states.
program plaza.kest
physics3d gravity 0 -10 0

collision class walker 5f23859a6c00ebba

# The mound's triangles, cooked from glTF (the plaza is played with its
# cooked content), and a crate's, each bringing its own materials, the
# crate's planks a texture kept exact (D314).
mesh 6d3cbd2231e069f1 mound.gltf
mesh 7f3a9c21e84d06b5 crate.gltf

# What the models are made of (D303): the strollers are brass, the pillars
# polished marble, and the floor paved, its slabs a texture (D309), kept
# exact: the browser test's software renderer pays dearly for sampling
# BC7, and its page runs the game on the same thread; everything else has
# no material and is its color. At the low quality the paving is a plain
# grey and samples no texture (D318).
texture 9f822820a44af4fc paving.png
# The sky all around (D322): a clear day's, written by tools/make_sky.py and
# cooked into an environment, seen behind everything and lighting it.
texture a97797a3a58f6d7a sky.hdr
# What the plaza's middle sees all around (D325, D326): baked by
# rawframe-bake from the probe's middle, and reflected, projected onto its
# box, by what stands in the plaza.
texture ac452b5e41f745bf hall.hdr
material 6d2c9bd611d50fdf brass.rfmaterial
material e4443f63fe935232 marble.rfmaterial
material b6b2fb38f649a30b paving.rfmaterial
# A warmth over the picture before the tonemapper (D350): a post process.
material 8d099ac296f9483e warmth.rfmaterial
# A monitor showing what a lens high over it sees (D361): the lens's view
# drawn into a render texture of 256 by 144 once a second, when asked,
# which the monitor's material shines with: a second view costs the
# browser's software rasterizer dearly.
rendertexture f18de9a0974d265b 256 144 on_demand
material a09d6b8277396fcd monitor.rfmaterial

# Split-screen (D362): two local players side by side, three with the
# first across the top, four in quarters.
layout 2 0 0 0.5 1 0.5 0 0.5 1
layout 3 0 0 1 0.5 0 0.5 0.5 0.5 0.5 0.5 0.5 0.5
layout 4 0 0 0.5 0.5 0.5 0 0.5 0.5 0 0.5 0.5 0.5 0.5 0.5 0.5 0.5

component 43f8c60f-1131-4732-8bed-d758dc5b5fa7 plaza.stick Stick
component 9b8e1f52-3c47-4d0a-a6e2-5f1d7c93b204 plaza.blade Blade
component 2d6e0b91-7c35-4f48-9a1e-3b5c8d0f6a27 plaza.stroller Stroller
component 6a1f0c3e-94b2-4d57-8e16-2b7d9c4f0a35 plaza.figure rawframe.model.Model
component 8e4b2c17-6a39-4d05-b1f8-7c2e9d4a3f61 plaza.look rawframe.model.Model
component 1f7d3a58-9c24-4e6b-8a03-5d9e1b7c2f84 plaza.view rawframe.model.Camera
component c3a95e27-4b18-4f6d-9a02-7e8d1b5c3f49 plaza.lantern rawframe.model.PointLight
component 5e0b8d24-71c3-4a96-b2f5-8d4c1e6a9f37 plaza.meter rawframe.model.AutoExposure
component b043a21b-26c9-4a2f-a09f-7026ca4cf0f7 plaza.hidden rawframe.model.AmbientOcclusion
component 0d4f7a2e-58c1-4b93-a6e0-3c9b2d7f1e84 plaza.sky rawframe.model.Sky
component 9c6fbc0e-7e12-4a6e-814f-b893a583b4d9 plaza.hall Hall
component a05f1e72-8622-4587-a629-f9a65dc4431a plaza.probe rawframe.model.ReflectionProbe
component 19968421-e479-4d0d-84b5-3f15409045fa plaza.warmth rawframe.model.PostProcess
component 8e5894e9-5540-470d-9ad5-9de0e9c44c1a plaza.spring Spring
component 23c49c96-4115-4e9b-93bf-ad66da086d57 plaza.fountain rawframe.model.ParticleEmitter
component e11486aa-d0b3-421d-aaf7-76d14abb942d plaza.trace rawframe.model.Trail
component ad3b9917-5f69-4d91-830b-b1aeab52a92e plaza.monitor Monitor
component 9c9c4ade-0b73-4b76-ab31-90b52b98ff23 plaza.screen rawframe.model.Model
component 05158b5b-4886-4c43-9384-9b9a9c0a3f4a plaza.lens rawframe.model.Camera
component 9ef4a751-96de-4694-b07d-b3fccbd00a18 plaza.watch rawframe.model.View
component da853e38-3ed1-4e7d-9ddb-4cf11b3834f2 plaza.shutter Shutter

# The blade's swing: its skeleton and clip under blade/, played on the
# server too, since the blade's body follows its bone.
animator 3a7d1f0c2b9e4d61 blade.rfanim

# The strollers' locomotion under stroll/: idle, walk, and run on a blend
# space by pace, synced by phase, moving them by root motion, their heads
# turned by a look-at the server runs too.
animator 5c7e2a91f04b3d68 stroll.rfanim parameters plaza.stroller

system plaza.join simulation join write rawframe.physics3d.body write rawframe.physics3d.pose write rawframe.physics3d.character with plaza.stick random spawn before rawframe.physics3d.step
system plaza.swing simulation swing read plaza.blade write rawframe.physics3d.target entities after rawframe.animation.step before rawframe.physics3d.step
system plaza.stroll simulation stroll write plaza.stroller read rawframe.animation.root_motion write rawframe.physics3d.pose entities after rawframe.animation.step
system plaza.walk simulation walk read plaza.stick read rawframe.physics3d.character write rawframe.physics3d.velocity before rawframe.physics3d.step predicted

# The plaza, eighty meters square, and walls around it.
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=40 height=0.5 depth=40 rawframe.physics3d.pose rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=0.5 height=5 depth=40 rawframe.physics3d.pose x=-40 y=5 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=0.5 height=5 depth=40 rawframe.physics3d.pose x=40 y=5 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=40 height=5 depth=0.5 rawframe.physics3d.pose z=-40 y=5 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=40 height=5 depth=0.5 rawframe.physics3d.pose z=40 y=5 rawframe.physics3d.velocity

# A terrace 2.7 meters up, a ramp of 20 degrees rising to it along x, and
# pillars.
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=6 height=1.37 depth=6 rawframe.physics3d.pose x=24 y=1.87 z=0 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=4 height=0.5 depth=3 rawframe.physics3d.pose x=14.4 y=1.4 qz=0.1736 qw=0.9848 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=3 width=1 height=3 rawframe.physics3d.pose x=-10 y=3.5 z=-10 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=3 width=1 height=3 rawframe.physics3d.pose x=10 y=3.5 z=-10 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=3 width=1 height=3 rawframe.physics3d.pose x=-10 y=3.5 z=10 rawframe.physics3d.velocity

# A gate in the far corner, hung on its post by a hinge that turns about
# the post.
scene gate.scene

# A blade hung from a pivot four meters up in the corner opposite the
# gate, swinging a quarter turn and back every two seconds at a
# walker's height: a kinematic box carried to the animated bone's pose
# each step, so it pushes what it meets.
spawn 1 plaza.blade pivotX=30 pivotY=4 pivotZ=30 rawframe.animation.animator graph=blade.rfanim relevance=1 rawframe.physics3d.body motion=1 shape=1 width=0.1 height=0.5 depth=0.8 rawframe.physics3d.pose x=30 y=1 z=30 rawframe.physics3d.velocity rawframe.physics3d.target

# The mound, ten meters across and 1.2 high, on the plaza's floor.
spawn 1 rawframe.physics3d.body motion=0 shape=4 rawframe.physics3d.pose x=-20 y=0.5 z=20 rawframe.physics3d.velocity rawframe.physics3d.mesh mesh=mound.gltf

# Three crates a meter on each side, one on the other two, beyond where
# walkers start.
spawn 1 rawframe.physics3d.body motion=0 shape=4 rawframe.physics3d.pose x=-22 y=1 z=-12 rawframe.physics3d.velocity rawframe.physics3d.mesh mesh=crate.gltf
spawn 1 rawframe.physics3d.body motion=0 shape=4 rawframe.physics3d.pose x=-20.9 y=1 z=-11.8 rawframe.physics3d.velocity rawframe.physics3d.mesh mesh=crate.gltf
spawn 1 rawframe.physics3d.body motion=0 shape=4 rawframe.physics3d.pose x=-21.45 y=2 z=-11.9 rawframe.physics3d.velocity rawframe.physics3d.mesh mesh=crate.gltf

# The plaza's reflection probe: a box over the whole floor and up past the
# terrace, its picture taken three meters above the middle.
spawn 1 plaza.hall halfX=40 halfY=7.5 halfZ=40 rawframe.physics3d.pose y=3 qw=1

# A spring eight meters before the plaza's middle, its jet leaving at
# seven meters a second (D353).
spawn 1 plaza.spring speed=7 rawframe.physics3d.pose x=0 y=0.5 z=-8 qw=1

# A monitor behind the spring, its screen 3.2 meters by 1.8 facing the
# middle, two and a half meters up (D361): within 30 meters of anywhere a
# walker starts, so every client is sent it.
spawn 1 plaza.monitor width=1.6 height=0.9 rawframe.physics3d.pose x=0 y=2.5 z=-10 qw=1

# Eight strollers about the plaza, each starting its round at another time.
spawn 1 plaza.stroller left=240 rawframe.physics3d.pose x=-12 y=1.4 z=-4 qw=1 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller left=210 rawframe.physics3d.pose x=-6 y=1.4 z=12 qw=1 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller left=180 rawframe.physics3d.pose x=4 y=1.4 z=-14 qw=1 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller left=150 rawframe.physics3d.pose x=12 y=1.4 z=6 qw=1 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller left=120 rawframe.physics3d.pose x=-18 y=1.4 z=8 qw=1 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller left=90 rawframe.physics3d.pose x=18 y=1.4 z=-8 qw=1 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller left=60 rawframe.physics3d.pose x=0 y=1.4 z=18 qw=1 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion
spawn 1 plaza.stroller left=30 rawframe.physics3d.pose x=-2 y=1.4 z=-20 qw=1 rawframe.animation.animator graph=stroll.rfanim relevance=1 rawframe.animation.root_motion

replicate plaza.stroller plaza.hall plaza.spring plaza.monitor rawframe.physics3d.body rawframe.physics3d.pose rawframe.physics3d.velocity rawframe.physics3d.character rawframe.physics3d.mesh plaza.stick
player plaza.stick rawframe.physics3d.body rawframe.physics3d.pose rawframe.physics3d.velocity rawframe.physics3d.character
input plaza.stick
# A client makes its stick from its player's actions (plaza.actions) with
# sample.kest; bots press the same keys and buttons.
actions plaza.actions
sample sample.kest sample
interest rawframe.physics3d.pose x z within 30
interpolate rawframe.physics3d.pose
predict rawframe.physics3d.body rawframe.physics3d.pose rawframe.physics3d.velocity rawframe.physics3d.character plaza.stick

# What a client draws (D283): every body it mirrors, by its shape and in
# a color for what it is, the mound and the crates as their own meshes in
# their own materials, through its own
# walker's camera, and the strollers as figures where their poses stand
# (D288), each with a lantern (D290), the view's exposure metered (D293),
# under the sky's picture (D322), reflecting the plaza's probe (D325),
# darkened where things meet (D327), warmed (D350), the spring's fountain
# (D353), the strollers' traces (D354), and the monitor's screen showing
# its lens's view (D361); no server carries a look, a figure, a lantern, a
# view, a meter, an occlusion, a sky, a probe, a warmth, a fountain, a
# trace, a screen, a lens, a shutter, or a watch.
presentation plaza.look on rawframe.physics3d.body
present plaza.dress dress read rawframe.physics3d.body write plaza.look
present plaza.dress_mesh dressMesh read rawframe.physics3d.mesh write plaza.look
presentation plaza.figure on plaza.stroller
present plaza.figure figure read plaza.stroller write plaza.figure
presentation plaza.lantern on plaza.stroller
present plaza.lantern lantern read plaza.stroller write plaza.lantern
presentation plaza.trace on plaza.stroller
present plaza.trace trace read plaza.stroller write plaza.trace
presentation plaza.view on player
present plaza.frame frame read plaza.stick write plaza.view
presentation plaza.meter on player
present plaza.meter meter read plaza.stick write plaza.meter
presentation plaza.hidden on player
present plaza.hidden hide read plaza.stick write plaza.hidden
presentation plaza.sky on player
present plaza.sky sky read plaza.stick write plaza.sky
presentation plaza.probe on plaza.hall
present plaza.probe probe read plaza.hall write plaza.probe
presentation plaza.warmth on player
present plaza.warm warm read plaza.stick write plaza.warmth
presentation plaza.fountain on plaza.spring
present plaza.fountain fountain read plaza.spring write plaza.fountain
presentation plaza.screen plaza.lens plaza.shutter plaza.watch on plaza.monitor
present plaza.screen screen read plaza.monitor write plaza.screen
present plaza.aim aim read plaza.monitor write plaza.lens
present plaza.watch watch read plaza.monitor write plaza.shutter write plaza.watch
