module sample

// A client's input for a walker (plaza.game's `sample` line): the stick,
// made each tick from its player's actions (plaza.actions). The view turns
// with the mouse while its right button is held, and with the arrow keys
// or the right stick (D521). Its heading is kept in the stick, which the
// sample builds on tick to tick (D525), and the walker runs along it: up
// runs the way the view looks along the ground.

import controls
import rawframe.input
import std.math

const MOVE: u64 = 0x2b8c866778ceb662
const JUMP: u64 = 0x2afb6c927e7f3e6f
const LOOK: u64 = 0xe43978625b6e00b9
const ORBIT: u64 = 0xdd9f99b9f2884926
const TURN: u64 = 0x991a5a8c8fdb1a14

// Radians the view turns for each unit of the mouse's motion, and in a
// tick at a full tilt of the arrow keys or the stick (about four tenths of
// a turn a second).
const MOUSE_TURN: f32 = 0.005
const STICK_TURN: f32 = 0.04

fn sample(into: [controls.Stick]) {
    // Turning right turns the view clockwise: its yaw falls. The mouse
    // turns it in a tick its right button was down in at all: a slow frame
    // reads a whole drag, press to release, as one tick.
    let turn = 0.0 - input.x(TURN) * STICK_TURN
    if input.on(ORBIT) || input.pressed(ORBIT) || input.released(ORBIT) {
        turn = turn - input.x(LOOK) * MOUSE_TURN
    }
    let heading = into[0].heading + turn
    if heading > 3.14159265 {
        heading = heading - 6.2831853
    }
    if heading < -3.14159265 {
        heading = heading + 6.2831853
    }
    into[0].heading = heading
    // A yaw of nought looks along -Z, a quarter turn along -X; right of the
    // view is its forward a quarter turn clockwise, seen from above.
    let forwardX = 0.0 - math.sin(heading)
    let forwardZ = 0.0 - math.cos(heading)
    let ahead = input.y(MOVE)
    let aside = input.x(MOVE)
    into[0].runX = aside * (0.0 - forwardZ) + ahead * forwardX
    into[0].runZ = aside * forwardX + ahead * forwardZ
    // A jump held now, or pressed in this tick at all, as the mouse's
    // button (D527).
    into[0].jump = 0.0
    if input.on(JUMP) || input.pressed(JUMP) {
        into[0].jump = 1.0
    }
}
