module canyon

// Quarry's own shape, field for field: the engine checks it is laid out as
// quarry's is.
struct Ground {
    x: u32
    z: u32
    seed: u32
    height: u32
}

// The canyon's columns across the land, from FROM up to but not including
// TO, along every row; its floor is one block deep, and its sides fall to it
// by one block a column.
const FROM: u32 = 14
const TO: u32 = 18
const FLOOR: u32 = 1

// What quarry asks about is lent as the one value of `values`; what is left
// there is the answer.
fn carve(values: [Ground]) {
    let x = values[0].x
    let away = u32(0)
    if x + u32(1) < FROM {
        away = FROM - x - u32(1)
    } else if x >= TO {
        away = x - TO + u32(1)
    }
    if x >= FROM && x < TO {
        values[0].height = FLOOR
    } else if FLOOR + away < values[0].height {
        values[0].height = FLOOR + away
    }
}
