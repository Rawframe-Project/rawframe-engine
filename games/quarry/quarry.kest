module quarry

// Quarry (D735): a land of blocks drawn from the World's seed, which players
// dig and build on. Each block is an entity of its own at a whole place on a
// grid of one meter; the land is made a few columns a tick, so no tick holds
// more than a system's commands, and a player digs the top block of the
// column it aims at, or places one on it, once in a while. A machine stands
// on the land (D737): a lever a player throws powers a lamp through wire,
// and a wire dug cuts it; players place wire, lamps, and levers as they
// place brick (D739), building machines of their own.

import controls
import rawframe.model
import rawframe.random
import rawframe.world

// The land is SIDE blocks each way; a column's ground is from LOWEST to
// HIGHEST blocks deep, drawn between heights picked at every CELL-th
// column, and nothing is built above CEILING.
const SIDE: u32 = 32
const CELL: u32 = 8
const LOWEST: u32 = 2
const HIGHEST: u32 = 10
const CEILING: u32 = 16

// Columns made a tick: at most about a thousand commands, each block a
// creation and two inserts.
const COLUMNS: u32 = 48

// A player's ticks between two of its digs or placements.
const REST: u32 = 30

// What a block is: the land's stone under two of earth with grass on top,
// and what players place, brick; and a machine's parts, from LEVER on.
const STONE: u8 = 1
const EARTH: u8 = 2
const GRASS: u8 = 3
const BRICK: u8 = 4
const LEVER: u8 = 5
const WIRE: u8 = 6
const LAMP: u8 = 7

// The machine the land is made with: a lever, then wire along its row,
// then a lamp, each on its column's ground.
const MACHINE_Z: u32 = 4
const LEVER_X: u32 = 4
const LAMP_X: u32 = 10

// The land's one entity: the seed its heights are drawn from, the next
// column to make, whether every column is made, and the blocks made.
struct Terrain {
    seed: u32
    next: u32
    made: bool
    blocks: u32
}

// A block where it stands: its column and its height above the bottom.
struct Block {
    x: u32
    y: u32
    z: u32
    kind: u8
}

// A machine's part, on its block alone (D737), so power looks at the parts
// and not the land: a lever thrown, and wire and a lamp powered, are `on`.
struct Part {
    on: bool
}

// A player's work: ticks until it may act again, and the blocks it has dug
// and placed.
struct Digger {
    rest: u32
    dug: u32
    placed: u32
}

extern fn Block.insert(entity: world.Entity, value: Block)
extern fn Block.count() -> i32
extern fn Block.entity(index: i32) -> world.Entity
extern fn Block.get(entity: world.Entity) -> Block
extern fn Part.insert(entity: world.Entity, value: Part)
extern fn Part.count() -> i32
extern fn Part.entity(index: i32) -> world.Entity
extern fn Part.get(entity: world.Entity) -> Part
extern fn Part.has(entity: world.Entity) -> bool
extern fn Terrain.count() -> i32
extern fn Terrain.get(entity: world.Entity) -> Terrain
extern fn Terrain.entity(index: i32) -> world.Entity

// A whole number from a lattice point and the seed, the same on every
// machine: the point's coordinates and the seed mixed by multiplying and
// shifting, all wrapping at 32 bits.
fn mixed(x: u32, z: u32, seed: u32) -> u32 {
    let h = x * u32(374761393) + z * u32(668265263) + seed * u32(2246822519)
    h = (h ^ (h >> u32(13))) * u32(1274126177)
    return h ^ (h >> u32(16))
}

// The ground's height at a lattice point, LOWEST to HIGHEST.
fn lattice(x: u32, z: u32, seed: u32) -> f32 {
    return f32(LOWEST) + f32(mixed(x, z, seed) % (HIGHEST - LOWEST + u32(1)))
}

// A column's height, drawn between the four lattice points round it.
fn height(x: u32, z: u32, seed: u32) -> u32 {
    let cx = x / CELL
    let cz = z / CELL
    let fx = f32(x % CELL) / f32(CELL)
    let fz = f32(z % CELL) / f32(CELL)
    let near = lattice(cx, cz, seed) * (1.0 - fx) + lattice(cx + u32(1), cz, seed) * fx
    let far = lattice(cx, cz + u32(1), seed) * (1.0 - fx) + lattice(cx + u32(1), cz + u32(1), seed) * fx
    return u32(near * (1.0 - fz) + far * fz + 0.5)
}

// One block made where it stands, persistent, so a save keeps it; a
// machine's part off.
fn make(x: u32, y: u32, z: u32, kind: u8) {
    let block = world.create()
    Block.insert(block, Block(x, y, z, kind))
    if kind >= LEVER {
        Part.insert(block, Part(false))
    }
    world.persist(block)
}

// The land, made COLUMNS columns a tick from the seed the first tick
// draws: stone, two of earth, and grass on top.
fn generate(count: i32, terrains: [Terrain], entities: [world.Entity]) {
    let i = 0
    while i < count {
        if !terrains[i].made {
            if terrains[i].seed == u32(0) {
                terrains[i].seed = random.below(0, u32(4294967295)) + u32(1)
            }
            let made = u32(0)
            while made < COLUMNS && terrains[i].next < SIDE * SIDE {
                let x = terrains[i].next % SIDE
                let z = terrains[i].next / SIDE
                let top = height(x, z, terrains[i].seed)
                let y = u32(0)
                while y < top {
                    let kind = STONE
                    if y + u32(1) == top {
                        kind = GRASS
                    } else if y + u32(3) >= top {
                        kind = EARTH
                    }
                    make(x, y, z, kind)
                    y = y + u32(1)
                }
                terrains[i].blocks = terrains[i].blocks + top
                terrains[i].next = terrains[i].next + u32(1)
                made = made + u32(1)
            }
            if terrains[i].next == SIDE * SIDE {
                // The machine, on the land's ground.
                let x = LEVER_X
                while x <= LAMP_X {
                    let kind = WIRE
                    if x == LEVER_X {
                        kind = LEVER
                    } else if x == LAMP_X {
                        kind = LAMP
                    }
                    make(x, height(x, MACHINE_Z, terrains[i].seed), MACHINE_Z, kind)
                    x = x + u32(1)
                }
                terrains[i].blocks = terrains[i].blocks + (LAMP_X - LEVER_X + u32(1))
                terrains[i].made = true
            }
        }
        i = i + 1
    }
}

// What a tool places (D739): brick, wire, a lamp, or a lever.
fn chosen(build: f32) -> u8 {
    if build < 0.5 {
        return BRICK
    }
    if build < 1.5 {
        return WIRE
    }
    if build < 2.5 {
        return LAMP
    }
    return LEVER
}

// The column a tool aims at: -1 to 1 across the land each way.
fn column(at: f32) -> u32 {
    let place = (at + 1.0) * 0.5 * f32(SIDE)
    if place < 0.0 {
        return u32(0)
    }
    if place >= f32(SIDE) {
        return SIDE - u32(1)
    }
    return u32(place)
}

// Each player rested digs the top block of the column it aims at, or
// places brick on it, the land once made; then rests.
fn dig(count: i32, tools: [controls.Tool], diggers: [Digger], entities: [world.Entity]) {
    if Terrain.count() == 0 || !Terrain.get(Terrain.entity(0)).made {
        return
    }
    let i = 0
    while i < count {
        if diggers[i].rest > u32(0) {
            diggers[i].rest = diggers[i].rest - u32(1)
        } else if tools[i].dig > 0.5 || tools[i].place > 0.5 || tools[i].use > 0.5 {
            let x = column(tools[i].x)
            let z = column(tools[i].z)
            // The column's top block, if it has one.
            let found = false
            // Held only once found; the player stands in till then.
            let top = entities[i]
            let topY = u32(0)
            let b = 0
            let blocks = Block.count()
            while b < blocks {
                let entity = Block.entity(b)
                let block = Block.get(entity)
                if block.x == x && block.z == z && (!found || block.y > topY) {
                    found = true
                    top = entity
                    topY = block.y
                }
                b = b + 1
            }
            let digging = tools[i].dig > 0.5
            let using = !digging && tools[i].use > 0.5
            // A lever on top is thrown.
            if using && found && Block.get(top).kind == LEVER && Part.has(top) {
                Part.insert(top, Part(!Part.get(top).on))
            }
            if digging && found {
                world.destroy(top)
                diggers[i].dug = diggers[i].dug + u32(1)
            }
            // Brick goes on the top block, or on the bottom where none is.
            let y = u32(0)
            if found {
                y = topY + u32(1)
            }
            if !digging && !using && y < CEILING {
                make(x, y, z, chosen(tools[i].build))
                diggers[i].placed = diggers[i].placed + u32(1)
            }
            diggers[i].rest = REST
        }
        i = i + 1
    }
}

// A block's color by its kind, 0xRRGGBBAA in sRGB: grey stone, brown
// earth, green grass, and red brick; a machine's parts dark, and bright
// while on.
fn colored(kind: u8, on: bool) -> u32 {
    if kind == LEVER {
        if on {
            return u32(0xE8C547FF)
        }
        return u32(0x4A3A22FF)
    }
    if kind == WIRE {
        if on {
            return u32(0xF0402AFF)
        }
        return u32(0x4A1C18FF)
    }
    if kind == LAMP {
        if on {
            return u32(0xFFF2B0FF)
        }
        return u32(0x30302CFF)
    }
    if kind == GRASS {
        return u32(0x5A8C3CFF)
    }
    if kind == EARTH {
        return u32(0x7A5634FF)
    }
    if kind == BRICK {
        return u32(0xA8442EFF)
    }
    return u32(0x8A8A86FF)
}

// Each block drawn as a box of half a meter's half sides where it stands,
// placed once: a block never moves, and its kind never changes; a
// machine's part colored again as it goes on or off.
fn dress(count: i32, blocks: [Block], looks: [model.Model], spots: [model.Placed], entities: [world.Entity]) {
    let half = f64(SIDE) * 0.5
    let i = 0
    while i < count {
        let b = blocks[i]
        let on = b.kind >= LEVER && Part.has(entities[i]) && Part.get(entities[i]).on
        if !spots[i].placed {
            looks[i] = model.Model(model.BOX, 0.5, 0.5, 0.5, colored(b.kind, on), u64(0), 0.0)
            spots[i] = model.Placed(true, f64(b.x) + 0.5 - half, f64(b.y) + 0.5, f64(b.z) + 0.5 - half)
        } else if b.kind >= LEVER && looks[i].color != colored(b.kind, on) {
            looks[i].color = colored(b.kind, on)
        }
        i = i + 1
    }
}

// Where the eye stands to see the whole land: above its near edge,
// looking along -Z and down at it.
const EYE_HEIGHT: f32 = 22.0
const EYE_BACK: f32 = 24.0
const EYE_PITCH: f32 = -0.62

fn frame(count: i32, views: [model.Camera]) {
    let i = 0
    while i < count {
        views[i] = model.Camera(0.0, EYE_HEIGHT, EYE_BACK, 0.0, EYE_PITCH, 1.0, 0.1, 15.0, u32(0), model.FIXED)
        i = i + 1
    }
}

// Power, each tick (D737), looking at the machines' parts alone: from
// every lever thrown, along wire, between
// machine parts in neighboring columns whatever their heights, to the
// lamps it reaches; a part neither powered nor thrown is off. A column's
// part is its highest; a lamp takes power and passes none on.
fn power(count: i32, terrains: [Terrain]) {
    if count == 0 || !terrains[0].made {
        return
    }
    let cells = i32(SIDE * SIDE)
    let parts = array(cells, -1)
    let made = Part.count()
    let p = 0
    while p < made {
        let block = Block.get(Part.entity(p))
        let cell = i32(block.x + block.z * SIDE)
        if parts[cell] < 0 || Block.get(Part.entity(parts[cell])).y < block.y {
            parts[cell] = p
        }
        p = p + 1
    }
    let powered = array(cells, false)
    let waiting: [i32] = array()
    let cell = 0
    while cell < cells {
        if parts[cell] >= 0 {
            let entity = Part.entity(parts[cell])
            if Block.get(entity).kind == LEVER && Part.get(entity).on {
                powered[cell] = true
                waiting.push(cell)
            }
        }
        cell = cell + 1
    }
    let next = 0
    while next < waiting.len() {
        let at = waiting[next]
        next = next + 1
        let x = at % i32(SIDE)
        let z = at / i32(SIDE)
        let side = 0
        while side < 4 {
            let nx = x
            let nz = z
            if side == 0 {
                nx = x - 1
            } else if side == 1 {
                nx = x + 1
            } else if side == 2 {
                nz = z - 1
            } else {
                nz = z + 1
            }
            side = side + 1
            if nx < 0 || nz < 0 || nx >= i32(SIDE) || nz >= i32(SIDE) {
                continue
            }
            let near = nx + nz * i32(SIDE)
            if parts[near] < 0 || powered[near] {
                continue
            }
            let kind = Block.get(Part.entity(parts[near])).kind
            if kind == WIRE || kind == LAMP {
                powered[near] = true
                if kind == WIRE {
                    waiting.push(near)
                }
            }
        }
    }
    // Wire and lamps told what they are now, those that changed alone.
    cell = 0
    while cell < cells {
        if parts[cell] >= 0 {
            let entity = Part.entity(parts[cell])
            if Block.get(entity).kind != LEVER && Part.get(entity).on != powered[cell] {
                Part.insert(entity, Part(powered[cell]))
            }
        }
        cell = cell + 1
    }
}
