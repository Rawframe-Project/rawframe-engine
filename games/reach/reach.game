# Reach, the small VR game: players sit round a table and pick up,
# hand over, and throw the blocks on it with their hands, Maul3D bodies all,
# the server deciding. A headset's controllers are a player's hands; a flat
# player reaches with one. VR and flat players share the one World,
# and the game is Palmshift's class among the
# constitution's reference games: hands, low-latency input and physics, and
# a small 3D World.
program reach.kest
physics3d gravity 0 -9.81 0

# Hands pass through each other; blocks meet everything.
collision class hand e6a4ac0cc7060f0b
collision class block a94a65b891476416
collision rule hand hand ignore

component dced10fa-8c5c-4fde-98c4-769f8565275c reach.hands Hands
component aa174e17-8efd-4de0-b82e-bd5b6d42d638 reach.seat Seat
component 8c4cd7c9-b5ff-4560-8edd-1dc2b3795509 reach.hand Hand
component ea827a4e-3a16-42dc-b120-eb28ea24c609 reach.block Block
component 84064735-82e5-4725-90d0-39e682d09191 reach.grip Grip
component a65063a9-817e-4430-acf5-f083fad0a263 reach.table Table
# A block's knock, cued by the server as it strikes something, heard by
# clients from where the block is.
component a0fd2692-1aa3-4429-bca5-5f8b4e743eff reach.knock rawframe.sound.Emitter
# What a client draws, where it looks from, and where it draws its own
# hands, each frame a headset's hands where they are then;
# no server carries any.
component 5a30e0bb-bf22-49df-b00a-22b24f0980ee reach.look rawframe.model.Model
component f0992124-ca0d-469d-8379-bfc5880526c8 reach.view rawframe.model.Camera
component ef26db88-b0b6-4651-a471-831d28226752 reach.placed rawframe.model.Placed
component 4c81e2f7-3a95-4d60-b7e8-19d4f6a2c053 reach.tracked rawframe.model.Tracked

# A player is seated, given two hands; each hand goes where its player
# holds it; a hand that grips near a block takes it, and lets it go when
# it opens.
system reach.join simulation join write reach.seat entities lookup reach.table before rawframe.physics3d.step
system reach.reach simulation reach read reach.hand write rawframe.physics3d.target entities lookup reach.hands lookup reach.seat lookup rawframe.physics3d.pose before rawframe.physics3d.step
system reach.grip simulation grip write reach.hand entities lookup reach.hands lookup reach.block lookup rawframe.physics3d.pose after rawframe.physics3d.step
system reach.knock simulation knock read rawframe.physics3d.contact write reach.knock after rawframe.physics3d.step
system reach.release simulation release read reach.grip entities lookup reach.hand lookup reach.hands lookup reach.block after reach.grip

# The floor, and a table 0.75 meters high, 1.2 by 0.8, which counts who
# has sat at it.
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=5 height=0.5 depth=5 friction=0.8 rawframe.physics3d.pose y=-0.5 rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=0 shape=1 width=0.6 height=0.375 depth=0.4 friction=0.8 rawframe.physics3d.pose y=0.375 rawframe.physics3d.velocity reach.table

# Six blocks of eight centimeters on the table.
spawn 1 rawframe.physics3d.body motion=2 shape=1 width=0.04 height=0.04 depth=0.04 collisionClass=block density=500 friction=0.7 rawframe.physics3d.pose x=-0.3 y=0.79 z=-0.15 rawframe.physics3d.velocity rawframe.physics3d.impulse rawframe.physics3d.contact reach.block reach.knock
spawn 1 rawframe.physics3d.body motion=2 shape=1 width=0.04 height=0.04 depth=0.04 collisionClass=block density=500 friction=0.7 rawframe.physics3d.pose x=0 y=0.79 z=-0.15 rawframe.physics3d.velocity rawframe.physics3d.impulse rawframe.physics3d.contact reach.block reach.knock
spawn 1 rawframe.physics3d.body motion=2 shape=1 width=0.04 height=0.04 depth=0.04 collisionClass=block density=500 friction=0.7 rawframe.physics3d.pose x=0.3 y=0.79 z=-0.15 rawframe.physics3d.velocity rawframe.physics3d.impulse rawframe.physics3d.contact reach.block reach.knock
spawn 1 rawframe.physics3d.body motion=2 shape=1 width=0.04 height=0.04 depth=0.04 collisionClass=block density=500 friction=0.7 rawframe.physics3d.pose x=-0.3 y=0.79 z=0.15 rawframe.physics3d.velocity rawframe.physics3d.impulse rawframe.physics3d.contact reach.block reach.knock
spawn 1 rawframe.physics3d.body motion=2 shape=1 width=0.04 height=0.04 depth=0.04 collisionClass=block density=500 friction=0.7 rawframe.physics3d.pose x=0 y=0.79 z=0.15 rawframe.physics3d.velocity rawframe.physics3d.impulse rawframe.physics3d.contact reach.block reach.knock
spawn 1 rawframe.physics3d.body motion=2 shape=1 width=0.04 height=0.04 depth=0.04 collisionClass=block density=500 friction=0.7 rawframe.physics3d.pose x=0.3 y=0.79 z=0.15 rawframe.physics3d.velocity rawframe.physics3d.impulse rawframe.physics3d.contact reach.block reach.knock

replicate rawframe.physics3d.body rawframe.physics3d.pose reach.block reach.seat reach.knock reach.hand reach.hands
entity reach.block holder
entity reach.hand player held
player reach.hands reach.seat
input reach.hands
# The hands' input, a headset's tracked poses in it, goes to its own
# player's client alone: the others see the hands the
# server moves, never the poses.
own reach.hands
# A client predicts its own hands' input, so it presents where its player
# holds them now; nothing else of the World is predicted.
predict reach.hands
# A client makes its hands from its player's actions (reach.actions) with
# sample.kest: a headset's controllers, or keys and the mouse; bots press
# the same controls.
actions reach.actions
sample sample.kest sample
interpolate rawframe.physics3d.pose

# A block knocks as it strikes the table, the floor, or another block
# (knock.sound, made by tools/make_knock.py), on the mixer's effects bus;
# a server carries only the counts.
mixer reach.mixer
sound 3494a617bc371640 knock.sound

# What a client draws: every body it mirrors, by its shape, from its own
# seat.
presentation reach.look on rawframe.physics3d.body
present reach.dress dress read rawframe.physics3d.body write reach.look
presentation reach.view on player
present reach.frame frame read reach.seat write reach.view
# The client's own hands, and a block one holds, drawn where its player
# holds them now.
presentation reach.placed on rawframe.physics3d.body
present reach.place placeOwn read rawframe.physics3d.body write reach.placed entities lookup reach.hand lookup reach.block lookup reach.hands lookup reach.seat lookup rawframe.physics3d.pose
# And, where a headset shows, where its hands are each frame between the
# ticks.
presentation reach.tracked on rawframe.physics3d.body
present reach.follow followOwn read rawframe.physics3d.body write reach.tracked entities lookup reach.hand lookup reach.block lookup rawframe.physics3d.pose
