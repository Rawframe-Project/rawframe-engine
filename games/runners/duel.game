# Runners without players, for tests: one runner firing to the right at
# another ten meters off, each spawned standing on the ground, and the
# shooter's moment fixed by hand (no connection claimed it, so nothing is
# gated). Same program and level as runners.game.
program runners.kest
physics2d gravity 0 -10 substeps 4

collision class runner 2ebcd16c10c5f6a4

component 6b05cdb4-0683-437a-aaac-7ad990b2ddb4 runners.stick Stick
component f6453556-fcdd-46e8-9208-866fade389cf runners.score Score
component 4a1a3d29-28e9-46fe-aae0-6bb3576ca9b3 runners.hit Hit
component 5f3691c6-292c-4054-b868-142fe8a4448f runners.emitter Emitter

system runners.join simulation join write rawframe.physics2d.body write rawframe.physics2d.pose write rawframe.physics2d.character with runners.stick random spawn before rawframe.physics2d.step
system runners.run simulation run read runners.stick read rawframe.physics2d.character write rawframe.physics2d.velocity before rawframe.physics2d.step predicted
system runners.shoot simulation shoot read runners.stick read rawframe.physics2d.pose read rawframe.replication.perception write runners.score write runners.emitter before rawframe.physics2d.step
system runners.hurt simulation hurt write runners.score read runners.hit entities

input runners.stick perceived

# The level (level.scene): the ground, eighty meters wide, walls at its
# ends, three platforms to jump up to, slopes of 20 degrees at both ends,
# and one of 55 too steep to stand on.
scene level.scene

# The shooter and its mark.
spawn 1 rawframe.physics2d.body motion=1 shape=2 fixedRotation=true collisionClass=runner width=0.3 height=0.4 rawframe.physics2d.pose x=-5 y=1.2 c=1 rawframe.physics2d.velocity rawframe.physics2d.character groundNormal=0.7 snap=0.2 runners.stick fire=1 aimX=1 runners.score runners.emitter rawframe.replication.perception baseTick=1
spawn 1 rawframe.physics2d.body motion=1 shape=2 fixedRotation=true collisionClass=runner width=0.3 height=0.4 rawframe.physics2d.pose x=5 y=1.2 c=1 rawframe.physics2d.velocity rawframe.physics2d.character groundNormal=0.7 snap=0.2 runners.stick runners.score runners.emitter rawframe.replication.perception baseTick=1
