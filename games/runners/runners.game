# The sample platformer: players are characters running and jumping about a
# level of platforms and slopes and shooting at each other, where the shooter
# saw the others; a runner hit is told so and counts it. Everything a player does moves no dynamic body, so a client
# predicts its own runner exactly; each client is sent what is within 30
# meters and sees the others between states.
program runners.kest
physics2d gravity 0 -10 substeps 4

collision class runner 2ebcd16c10c5f6a4

component 6b05cdb4-0683-437a-aaac-7ad990b2ddb4 runners.stick Stick
component f6453556-fcdd-46e8-9208-866fade389cf runners.score Score
component 4a1a3d29-28e9-46fe-aae0-6bb3576ca9b3 runners.hit Hit
component 5f3691c6-292c-4054-b868-142fe8a4448f runners.emitter Emitter
component 8c4e2a17-5b90-4d3f-a6e8-1f7c9d0b2e53 runners.age Age

system runners.join simulation join write rawframe.physics2d.body write rawframe.physics2d.pose write rawframe.physics2d.character with runners.stick random spawn before rawframe.physics2d.step
system runners.run simulation run read runners.stick read rawframe.physics2d.character write rawframe.physics2d.velocity before rawframe.physics2d.step predicted
system runners.shoot simulation shoot read runners.stick read rawframe.physics2d.pose read rawframe.replication.perception write runners.score write runners.emitter before rawframe.physics2d.step
system runners.hurt simulation hurt write runners.score read runners.hit entities
system runners.age simulation age write runners.age

# The level (level.scene): the ground, eighty meters wide, walls at its
# ends, three platforms to jump up to, slopes of 20 degrees at both ends,
# and one of 55 too steep to stand on.
scene level.scene

# The hall (hall.scene): one persistent entity that keeps how long the level
# has been played. A server with `save.directory` keeps it between runs.
scene hall.scene
save hall runners.age
# Each player keeps their score between visits, under the session they ask
# for.
save player runner runners.score

# Anyone may mod it (runners-timers is one): a mod adds timers, entities
# holding runners.age that the age system counts up as it does the hall's.
mods open
modapi runners 1
extension timers data runners.age multi

replicate rawframe.physics2d.body rawframe.physics2d.pose rawframe.physics2d.velocity rawframe.physics2d.character runners.stick runners.score runners.emitter
player runners.stick runners.score runners.emitter rawframe.physics2d.body rawframe.physics2d.pose rawframe.physics2d.velocity rawframe.physics2d.character rawframe.replication.perception
input runners.stick perceived
# A client makes its stick from its player's actions (runners.actions) with
# sample.kest; bots press the same keys and buttons.
actions runners.actions
sample sample.kest sample
interest rawframe.physics2d.pose x y within 30
interpolate rawframe.physics2d.pose
predict rawframe.physics2d.body rawframe.physics2d.pose rawframe.physics2d.velocity rawframe.physics2d.character runners.stick

# Each shot sounds from the runner that fired it (runners.mixer, shot.sound);
# clients hear them, a server carries only the counts.
mixer runners.mixer
sound 950e09337d03de69 shot.sound

# What a client shows: the HUD's words in English and Turkish (hud.strings,
# hud.tr.translations), English unless the player asks otherwise. A server
# never reads them.
text hud.strings
text hud.tr.translations
locale en
