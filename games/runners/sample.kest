module sample

// A client's input for a runner (runners.game's `sample` line): the stick,
// made each tick from its player's actions (runners.actions). While the aim
// is not pushed, the runner aims where the mouse points: the pointer's
// place in the window less the canvas view's, picked through its camera
// onto the level's plane (D368).

import controls
import rawframe.input
import rawframe.view

const RUN: u64 = 0x9182d0b16cbd7c9c
const JUMP: u64 = 0x2cb70c262f28ab66
const AIM: u64 = 0x302f813f89c1849d
const FIRE: u64 = 0xd1e5c72fda17a16f
const POINT: u64 = 0x7c3e91a5d40b26f8

// One for on, nought for off: the stick's half-way rule reads it back.
fn level(on: bool) -> f32 {
    if on {
        return 1.0
    }
    return 0.0
}

fn sample(into: [controls.Stick]) {
    into[0].run = input.x(RUN)
    into[0].jump = level(input.on(JUMP))
    into[0].aimX = input.x(AIM)
    into[0].aimY = input.y(AIM)
    into[0].fire = level(input.on(FIRE))
    // The pointer is on once the mouse has been over the window; a bot,
    // and a player before its first frame, has no view to pick through.
    into[0].pointed = 0.0
    if input.on(POINT) && input.x(AIM) == 0.0 && input.y(AIM) == 0.0 {
        let place = view.canvasPlace()
        let world = view.pointToWorld2D(input.x(POINT) - place.left, input.y(POINT) - place.top)
        if place.failure == u32(0) && world.failure == u32(0) {
            into[0].pointed = 1.0
            into[0].targetX = f32(world.x)
            into[0].targetY = f32(world.y)
        }
    }
}
