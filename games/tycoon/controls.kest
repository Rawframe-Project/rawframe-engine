module controls

import rawframe.ui

// What an owner's player asks of it each tick, apart from the game so that
// the game and a client's sample program (sample.kest) share the one type:
// to move the cursor along x and z (each -1 to 1), to put it on the place
// the player points at (`pointed` above a half, at `pointX`, `pointZ` on the
// ground), and to build there (above a half).
struct Hand {
    moveX: f32
    moveZ: f32
    pointed: f32
    pointX: f32
    pointZ: f32
    build: f32
}

// The purse's press code, which `ui.hovered()` names under the mouse
// and a client's sample reads a press of.
const PURSE: i64 = 1

// What an owner's player asks for by pressing its purse: its stalls'
// takings collected at once. A command carries a value; this one says
// nothing more than that it was asked.
struct Collect {
    asked: u32
}

// The sign field's press code: the field an owner's player writes
// its stall's sign in, given to the server when the player presses Enter.
const SIGN: i64 = 2

// The zoom slider's press code, by which a present system reads the
// value the player slid it to.
const ZOOM: i64 = 3

// The top view switch's press code, by which a present system reads
// whether the player turned it on.
const TOP: i64 = 4

// What an owner's player wrote on its sign.
struct Sign {
    typed: ui.Typed
}
