module sample

// A client's input for an owner (tycoon.game's `sample` line): the hand,
// made each tick from its player's actions (tycoon.actions). The cursor
// moves with the move action, up the screen along -Z; where the mouse
// points, the ray through its camera picks the place on the ground it
// meets. A bot, and a player before its first frame, has no view to pick
// through. A press on the purse asks the server to collect the owner's
// takings (D425); what the player writes in the sign field and gives by
// Enter goes to the server as its sign (D426). The menu action (Tab, or a
// gamepad's Start) has the HUD navigated without the mouse: the arrows or
// the d-pad, Tab or the shoulders, to the purse and the sign field, Enter
// or the south button to press or write (D430).

import controls
import rawframe.input
import rawframe.view

const MOVE: u64 = 0x553136d0f09c1542
const BUILD: u64 = 0x42402c54c83df116
const POINT: u64 = 0x60122f83dd6bbe0b
const MENU: u64 = 0xdccd8b3fbc9eae0a

extern fn Commands.collect(value: controls.Collect)
extern fn Commands.sign(value: controls.Sign)

fn sample(into: [controls.Hand]) {
    into[0].moveX = input.x(MOVE)
    into[0].moveZ = 0.0 - input.y(MOVE)
    // A build held now, or pressed in this tick at all: a slow frame reads
    // a quick tap, press to release, as one tick (D527).
    into[0].build = 0.0
    if input.on(BUILD) || input.pressed(BUILD) {
        into[0].build = 1.0
    }
    into[0].pointed = 0.0
    if input.on(POINT) {
        let place = view.scenePlace()
        let ray = view.pointToRay(input.x(POINT) - place.left, input.y(POINT) - place.top)
        // Down toward the ground, meeting it ahead.
        if place.failure == u32(0) && ray.failure == u32(0) && ray.directionY < -0.01 {
            let ahead = (0.0 - ray.originY) / f64(ray.directionY)
            into[0].pointed = 1.0
            into[0].pointX = f32(ray.originX + f64(ray.directionX) * ahead)
            into[0].pointZ = f32(ray.originZ + f64(ray.directionZ) * ahead)
        }
    }
    if input.pressed(MENU) {
        input.uiNavigate()
    }
    if input.uiPressed() == controls.PURSE {
        Commands.collect(controls.Collect(u32(1)))
    }
    if input.uiSubmitted() == controls.SIGN {
        Commands.sign(controls.Sign(input.uiTyped()))
    }
}
