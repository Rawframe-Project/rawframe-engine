{
  "formatVersion": 1,
  "kind": "text.strings",
  "sourceLocale": "en",
  "entries": {
    "hud.coins": {
      "message": ".input {$coins :integer}\n.match $coins\none {{{$coins} coin}}\n* {{{$coins} coins}}",
      "description": "The owner's coins, shown in the HUD."
    },
    "hud.lost": {
      "message": "Round {$round :integer} went to another owner.",
      "description": "Shown to every other owner when a round ends."
    },
    "hud.sign": {
      "message": "Write your sign",
      "description": "The sign field's placeholder while it is empty."
    },
    "hud.top": {
      "message": "Top view",
      "description": "The name a screen reader reads for the switch that turns the view to look straight down."
    },
    "hud.won": {
      "message": "You won round {$round :integer}!",
      "description": "Shown to the owner that won a round, when it ends."
    },
    "hud.zoom": {
      "message": "Zoom",
      "description": "The name a screen reader reads for the slider that brings the view nearer or further."
    }
  }
}
