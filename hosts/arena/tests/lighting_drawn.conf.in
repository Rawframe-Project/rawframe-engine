# The Lighting Test (D749): two bots in the fixture while the first one's
# view is drawn offscreen and the last frame written to a TGA image, which
# lighting_seen.py reads for each lamp's light. Ten seconds, as the
# plaza's drawn run (D343, D373).
host.maximum_iterations = 1200
host.iteration_rate = 120
world.tick_rate = 60
kest.game = @PROJECT_SOURCE_DIR@/games/lighting/lighting.game
content.root = @LIGHTING_CONTENT@
network.loopback.latency_ms = 10
replication.endpoint = arena
bots.count = 2
bots.endpoint = arena
render.device = any
render.offscreen = true
render.width = 640
render.height = 360
render.capture = @CAPTURE@
scene.shadow_side = 256
render.read_every = 8
# What is checked is what is drawn, not how fast a loaded machine ticks
# (D212, D516).
world.degraded_ms = 600000
world.overload_ms = 0
