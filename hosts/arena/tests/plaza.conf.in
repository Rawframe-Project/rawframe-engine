# Sixteen bots against the sample 3D game for a second of play; the
# server's physics summary shows the plaza and a walker for each player made,
# and the walkers moved as characters. The mound's mesh is read from the
# plaza's content cooked into the build tree.
host.maximum_iterations = 120
host.iteration_rate = 120
world.tick_rate = 60
kest.game = @PROJECT_SOURCE_DIR@/games/plaza/plaza.game
content.root = @PLAZA_CONTENT@
network.loopback.latency_ms = 10
replication.endpoint = arena
bots.count = 16
bots.endpoint = arena
