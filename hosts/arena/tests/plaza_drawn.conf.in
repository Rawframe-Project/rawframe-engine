# Two bots play the sample 3D game for ten seconds while the first one's
# scene is drawn on the one device into an offscreen picture, as its player
# would see it (D284, D285): one frame in sixty is read back and counted in
# colors; the last is written to a TGA image in the build tree. The mound's
# mesh is read from the plaza's content cooked into the build tree. A
# software rasterizer may serve. Ten seconds, since a loaded machine has
# taken three before the client saw its World (D343), and a full check
# more than six (D373).
host.maximum_iterations = 1200
host.iteration_rate = 120
world.tick_rate = 60
kest.game = @PROJECT_SOURCE_DIR@/games/plaza/plaza.game
content.root = @PLAZA_CONTENT@
network.loopback.latency_ms = 10
replication.endpoint = arena
bots.count = 2
bots.endpoint = arena
render.device = any
render.offscreen = true
render.width = 640
render.height = 360
render.capture = @CAPTURE@
# A small shadow map and pictures read back often: a software rasterizer
# under the full check's load draws few frames, fewer still since the
# ambient occlusion (D327, D329).
scene.shadow_side = 256
render.read_every = 8
# What is checked is what is drawn, not how fast a loaded machine ticks:
# the World may fall behind without the server refusing the bots, as a
# World a second behind refuses players (D212, D516).
world.degraded_ms = 600000
world.overload_ms = 0
