# Four bots predicting their walkers in the sample 3D game for five seconds:
# characters among a static plaza mispredict only while each bot's input
# first arrives.
host.maximum_iterations = 600
host.iteration_rate = 120
world.tick_rate = 60
kest.game = games/plaza/plaza.game
content.root = @PLAZA_CONTENT@
network.loopback.latency_ms = 10
replication.endpoint = arena
bots.count = 4
bots.endpoint = arena
