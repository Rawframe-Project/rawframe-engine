# Four bots play the sample platformer for three seconds while the first
# two's canvases are drawn split-screen on the one device into an offscreen
# picture, as two local players would see them (D279, D285, D364), one
# over the other: one frame in eight is read back, so a loaded machine
# that draws fifty frames still reads some (it drew no sixtieth), and its
# sprites cover pixels; the last is written to a TGA image in the build tree. Its textures are read from the game's content
# cooked into the build tree. A software rasterizer may serve.
host.maximum_iterations = 360
host.iteration_rate = 120
world.tick_rate = 60
kest.game = @PROJECT_SOURCE_DIR@/games/runners/runners.game
content.root = @CONTENT@
network.loopback.latency_ms = 10
replication.endpoint = arena
bots.count = 4
bots.local_players = 2
bots.endpoint = arena
render.device = any
render.offscreen = true
render.width = 640
render.height = 360
render.read_every = 8
render.capture = @CAPTURE@
# What is checked is what is drawn, not how fast a loaded machine ticks:
# the World may fall behind without the server refusing the bots, as a
# World a second behind refuses players (D212, D516).
world.degraded_ms = 600000
world.overload_ms = 0
