# Eight bots play the sample platformer for eight seconds while the first
# one's mirrored World is heard as its player would hear it and written to a
# WAVE file in the build tree: shots sound, from where they were fired, and
# its own jumps as they are predicted.
# Its sounds are read by identity from the game's content cooked into the
# build tree.
# Eight seconds, not four: under a loaded machine's pacing the first bot
# was sometimes never hit in four, and so never winced (D401).
host.maximum_iterations = 960
host.iteration_rate = 120
world.tick_rate = 60
kest.game = @PROJECT_SOURCE_DIR@/games/runners/runners.game
content.root = @CONTENT@
network.loopback.latency_ms = 10
replication.endpoint = arena
bots.count = 8
bots.endpoint = arena
audio.record = @RECORD@
