# Eight bots tend their stalls for five seconds (D388): they move their
# cursors with sticks and keys and press build.
host.maximum_iterations = 600
host.iteration_rate = 120
world.tick_rate = 60
kest.game = @PROJECT_SOURCE_DIR@/games/tycoon/tycoon.game
# Its content cooked into the build tree, as its customers' figure is a
# mesh (D512).
content.root = @TYCOON_CONTENT@
network.loopback.latency_ms = 10
replication.endpoint = arena
bots.count = 8
bots.endpoint = arena
