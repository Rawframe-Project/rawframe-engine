# The Lighting Test's probe baked (D755): a bot looks at the wall while its
# scene is drawn offscreen, and once sixty frames were presented the
# probe's picture is drawn six ways from its middle, before the wall among
# the lamps, and written, as Radiance, into the build tree. A loaded
# machine's frames may come slowly: neither side stops for it.
host.maximum_iterations = 480
host.iteration_rate = 120
world.tick_rate = 60
kest.game = @PROJECT_SOURCE_DIR@/games/lighting/lighting.game
content.root = @LIGHTING_CONTENT@
network.loopback.latency_ms = 10
replication.endpoint = arena
bots.count = 1
bots.endpoint = arena
render.device = any
render.offscreen = true
render.width = 128
render.height = 128
scene.shadow_side = 512
bake.directory = @BAKED@
bake.after = 60
bake.width = 256
world.degraded_ms = 600000
world.overload_ms = 0
