# The client's own walker in the plaza, drawn in 3D on the one device and
# shown in its window (D286): the mound's mesh read from the plaza's
# content cooked into the build tree, a software rasterizer allowed, and
# the picture read back once in sixty frames, the last written to a TGA
# image in the build tree.
bots.player = true
render.device = any
content.root = @PLAZA_CONTENT@
render.capture = @CAPTURE@
