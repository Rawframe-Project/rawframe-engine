# The client's own walker in the plaza, drawn in 3D on the one device and
# shown in its window (D286): the mound's mesh read from the plaza's
# content cooked into the build tree, a software rasterizer allowed, and
# the picture read back once in sixty frames, the last written to a TGA
# image in the build tree.
bots.player = true
render.device = any
content.root = @PLAZA_CONTENT@
render.capture = @CAPTURE@
# A small shadow map and pictures read back often: a software rasterizer
# under the full check's load draws few frames.
scene.shadow_side = 256
render.read_every = 20
# The machine's gamepads left out: another program's virtual pads would
# play this client's player (D467).
input.gamepads = false
# Thirty frames a second: drawn by software, as many as the Host iterates
# held most of a full check's processors (D495).
render.frame_rate = 30
