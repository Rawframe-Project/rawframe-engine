# Reach on a headset (D657): the client's own player seated at the table,
# the room drawn for each of the headset's eyes from its seat, and the
# headset's controllers its hands, fed to its player's mapper as the
# window's devices are; a flat bot plays beside it in the same World.
bots.player = true
render.device = any
input.gamepads = false
render.frame_rate = 30
xr.headset = true
@RAWFRAME_TEST_XR_RUNTIME@
xr.panel_width = 320
xr.panel_height = 180
# What is checked is what is drawn, not how fast a loaded machine ticks
# (D212, D516).
world.overload_ms = 0
