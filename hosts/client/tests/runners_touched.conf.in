# The client's own player at Runners as on a phone, the mouse played as a
# finger (D809), drawn on the one device and shown in its window, its sound
# played to no device (D625), from Runners' content cooked into the build
# tree.
bots.player = true
render.device = any
content.root = @CONTENT@
audio.play = null
# What is checked is where presses go, not how fast a loaded machine
# draws: the client's World may fall behind without stopping it.
world.overload_ms = 0
# The machine's gamepads left out: another program's virtual pads would
# play this client's player (D467).
input.gamepads = false
# Thirty frames a second: drawn by software, as many as the Host iterates
# held most of a full check's processors (D495).
render.frame_rate = 30
# The mouse a finger, as a game made for touch is tried on a desktop.
input.touch_from_mouse = true
