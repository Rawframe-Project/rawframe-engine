# The client's own player at Stalls, drawn on the one device and shown in
# its window, its HUD's words in the game's font from Stalls' content cooked
# into the build tree (D421).
bots.player = true
render.device = any
content.root = @TYCOON_CONTENT@
# What is checked is where presses and keys go, not how fast a loaded
# machine draws: the client's World may fall behind without stopping it.
world.overload_ms = 0
# The machine's gamepads left out: another program's virtual pads would
# play this client's player (D467).
input.gamepads = false
# Thirty frames a second: drawn by software, as many as the Host iterates
# held most of a full check's processors (D495).
render.frame_rate = 30
