module rawframe.canvas

// 2D pictures as World data (SPEC-0024's canvas, D254): what an entity
// shows, drawn where its pose (rawframe.physics2d's Pose2D) puts it. A game
// declares a component of this type; clients draw it, and a server carries
// it as it carries any other value, with no drawing of its own.

// A picture: a region of a texture, by the identity the game's `texture`
// line gives it, `width` by `height` meters, placed so the point at
// (`pivotX`, `pivotY`) of it, each from nought (left, bottom) to one, is on
// the pose, and turned as the pose turns. The region is in the texture's
// own terms, nought to one from its top left; past one the texture repeats,
// so a region four wide tiles it four times. `color` multiplies it, as
// 0xRRGGBBAA; an alpha of nought draws nothing, as does texture nought.
// Higher `layer`s draw over lower ones.
//
// A sprite sheet is a grid of equal cells, the region its first: `frame`
// counts cells along a row of `columns` (nought is one), then down the
// next, so frame 5 of a sheet four wide is the second row's second cell. A
// region mirrored (`u0` past `u1`) moves along the sheet as it is.
// An animator's discrete track (D139) steps it, a flipbook.
struct Sprite {
    texture: u64
    u0: f32
    v0: f32
    u1: f32
    v1: f32
    width: f32
    height: f32
    pivotX: f32
    pivotY: f32
    color: u32
    layer: i32
    frame: u32
    columns: u32
}

// White, untinted: the texture as it is.
const WHITE: u32 = 0xFFFFFFFF
