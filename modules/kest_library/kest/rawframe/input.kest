module rawframe.input

// A player's actions as its client committed them for the tick being sampled,
// named by each action's identity in the game's action set.
// Only a game's sample program reads them, and only on a client: the server
// has no actions, only the input they became.

import rawframe.ui

extern fn Input.on(action: u64) -> bool
extern fn Input.pressed(action: u64) -> bool
extern fn Input.released(action: u64) -> bool
extern fn Input.x(action: u64) -> f32
extern fn Input.y(action: u64) -> f32

// Whether the action is on, by its thresholds.
fn on(action: u64) -> bool {
    return Input.on(action)
}

// Whether it turned on during the tick, even if it turned off again.
fn pressed(action: u64) -> bool {
    return Input.pressed(action)
}

// Whether it turned off during the tick.
fn released(action: u64) -> bool {
    return Input.released(action)
}

// Its first axis: a bool's is one when on.
fn x(action: u64) -> f32 {
    return Input.x(action)
}

// Its second axis, for a two-axis action.
fn y(action: u64) -> f32 {
    return Input.y(action)
}

extern fn Input.z(action: u64) -> f32
extern fn Input.turnX(action: u64) -> f32
extern fn Input.turnY(action: u64) -> f32
extern fn Input.turnZ(action: u64) -> f32
extern fn Input.turnW(action: u64) -> f32
extern fn Input.tracked(action: u64) -> bool

// A pose action (a controller's grip or aim) is on while the runtime
// knows where it is; `x` and `y` give its place's first two axes, and these
// its third, in meters in the headset's play space (+Y up, the origin where
// the head was when its session began).
fn z(action: u64) -> f32 {
    return Input.z(action)
}

// Its turn, a unit quaternion's parts.
fn turnX(action: u64) -> f32 {
    return Input.turnX(action)
}

fn turnY(action: u64) -> f32 {
    return Input.turnY(action)
}

fn turnZ(action: u64) -> f32 {
    return Input.turnZ(action)
}

fn turnW(action: u64) -> f32 {
    return Input.turnW(action)
}

// Whether the runtime tracks it now, rather than inferring where it is.
fn tracked(action: u64) -> bool {
    return Input.tracked(action)
}

extern fn Input.headset() -> bool

// Whether the player sees the game on a headset now: written into
// the game's input, a server knows each tick who plays in XR, and takes its
// own stance; the engine takes none.
fn headset() -> bool {
    return Input.headset()
}

// A joint of a tracked hand: where it is,
// in meters in the headset's play space as a pose action's place is, its
// turn, a unit quaternion's parts, and its radius in meters. Not `located`
// where the runtime does not know where it is.
struct Joint {
    located: bool
    x: f32
    y: f32
    z: f32
    turnX: f32
    turnY: f32
    turnZ: f32
    turnW: f32
    radius: f32
}

// The hands, and each hand's joints in OpenXR's order: the palm, the
// wrist, then each finger from its root to its tip.
const LEFT: u32 = 0
const RIGHT: u32 = 1
const PALM: u32 = 0
const WRIST: u32 = 1
const THUMB_TIP: u32 = 5
const INDEX_TIP: u32 = 10
const MIDDLE_TIP: u32 = 15
const RING_TIP: u32 = 20
const LITTLE_TIP: u32 = 25
const JOINTS: u32 = 26

extern fn Input.handTracked(hand: u32) -> bool
extern fn Input.joint(hand: u32, index: u32) -> Joint

// Whether the headset's runtime tracks the hand (`LEFT` or `RIGHT`) now:
// a hand seen by its cameras, not a controller held in it. False for a
// player who wears no headset, or whose runtime tracks no hand. A hand is
// not an action: the sample reads it apart from the action set, and the
// World learns of it only what the sample writes into the game's input.
fn handTracked(hand: u32) -> bool {
    return Input.handTracked(hand)
}

// Joint `index` of the hand, below `JOINTS`.
fn joint(hand: u32, index: u32) -> Joint {
    return Input.joint(hand, index)
}

extern fn UI.pressed() -> i64

// The `press` of the UI node the player's press landed on during the tick,
// the first if more than one, or nought for none (rawframe.ui): a
// press the UI took, which no action saw, or the node the player activated
// by navigation.
fn uiPressed() -> i64 {
    return UI.pressed()
}

extern fn UI.submitted() -> i64
extern fn UI.typed() -> ui.Typed

// The `press` of the text field whose text the player gave during the tick
// by Enter, or nought for none (rawframe.ui).
fn uiSubmitted() -> i64 {
    return UI.submitted()
}

// What the player gave it, empty when nothing was given.
fn uiTyped() -> ui.Typed {
    return UI.typed()
}

extern fn UI.navigate() -> bool
extern fn UI.navigating() -> bool

// The player's UI navigated without a pointer from the next tick:
// focus on the first node that takes presses or text of its view, in
// reading order, unless one holds it. The engine's navigation actions (the
// arrow keys and the d-pad, Tab and the shoulders, Enter, Space, and the
// south face button, Escape and the east) are then the UI's, never the
// game's, until it lets focus go. Whether a node holds focus now; false
// with nothing to focus, and for any local player but the first.
fn uiNavigate() -> bool {
    return UI.navigate()
}

// Whether the player's UI holds focus, so the navigation actions are its.
fn uiNavigating() -> bool {
    return UI.navigating()
}

extern fn Text.offered() -> u32
extern fn Text.chosen() -> u32
extern fn Text.choose(index: u32) -> bool

// How many locales the player may choose among while playing: the
// game's default first, then each its translations are in, by tag. Nought
// for a bot, or a game without text.
fn locales() -> u32 {
    return Text.offered()
}

// Which of them the player's words are given in; `locales()` for one
// configured that none of them is.
fn locale() -> u32 {
    return Text.chosen()
}

// The player's words given in the locale at `index` of them from now on,
// the labels in their view formatted again; false for none such. Each
// local player has their own; the others keep theirs.
fn chooseLocale(index: u32) -> bool {
    return Text.choose(index)
}
