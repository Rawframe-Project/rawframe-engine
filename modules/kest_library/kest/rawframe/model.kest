module rawframe.model

// 3D pictures as World data (SPEC-0024's scene, D283): what an entity
// shows, drawn where its pose (rawframe.physics3d's Pose3D) puts it, lit
// by the sun and the sky. A game declares components of these types;
// clients draw them, and a server carries them as it carries any other
// value, with no drawing of its own.

// A mesh drawn at the pose: the game's cooked mesh of the identity its
// `mesh` line gives it, or one of the engine's own below, scaled by
// `scaleX`, `scaleY`, and `scaleZ` along the pose's own axes, and turned
// as the pose turns. `material` is the game's surface material of the
// identity its `material` line gives it (D303), or nought for none: a
// plain surface, OpenPBR's but for a white base color. `color`, 0xRRGGBBAA
// in sRGB, tints the material's base color, so without one it is the base
// color; an alpha of nought, a scale of nought, or mesh nought draws
// nothing.
struct Model {
    mesh: u64
    scaleX: f32
    scaleY: f32
    scaleZ: f32
    color: u32
    material: u64
}

// The engine's own meshes, each one meter from its center to its sides,
// so a Model's scale is the body's (rawframe.physics3d's Body3D) half
// sides or radius: a box of half sides one; a sphere of radius one; an
// upright cylinder of radius one and half height one; an upright capsule
// of radius one whose two centers are one above and below its center (a
// scale along its axis stretches its caps too).
const BOX: u64 = 0x3ff8cd61f01cf46b
const SPHERE: u64 = 0x2c6b82d75f7be712
const CYLINDER: u64 = 0xaee26a717a3a62a0
const CAPSULE: u64 = 0x63ed148327123836

// A client's view of the 3D World (ADR-0052's camera), on the client's
// own player: a presentation component (`presentation <camera> on
// player`) its present systems place. The eye is `offsetX`, `offsetY`,
// and `offsetZ` meters from the player's pose, in the World's axes, and
// looks along `yaw` radians about +Y (nought looks along -Z, a quarter
// turn along -X) and `pitch` radians above the ground's plane. `fovY` is
// the vertical field of view in radians (a wider window sees more,
// Hor+), and `near` the nearest distance drawn, in meters; the far one is
// unbounded. `exposure` is the camera's EV100 (ADR-0047): 15 for a sunny
// day, lower for dimmer scenes. `tonemapper` maps its light for display
// (ADR-0047's closed set): AGX (nought, the default), PBR_NEUTRAL for
// colours reproduced as authored, or LINEAR for measuring; each keeps
// middle grey where AgX puts it, and another value is AgX. A camera with a
// field of view not above nought draws nothing. Without one, a client's
// view looks at its player from behind and above.
struct Camera {
    offsetX: f32
    offsetY: f32
    offsetZ: f32
    yaw: f32
    pitch: f32
    fovY: f32
    near: f32
    exposure: f32
    tonemapper: u32
}

// The tonemappers a camera may map its light with (ADR-0047).
const AGX: u32 = 0
const PBR_NEUTRAL: u32 = 1
const LINEAR: u32 = 2

// A camera's grading (ADR-0051, ADR-0047), on the same entity as its
// camera: the scene's light, before it is mapped for display, balanced to
// a white `temperature` warmer (above nought) or cooler and `tint` more
// magenta (above nought) or green, about minus one to one; then each
// channel times its `slope`, plus its `offset`, to the power of its
// `power` (ASC CDL); then `saturation` (one keeps it, nought is grey) and
// `contrast` about middle grey (one keeps it); then, with a `table` (a
// game texture cooked from a `.cube` file), each color looked up in it
// (D344), the table's coordinates the ACEScct curve's encoding of the
// light as the exposure leaves it. One with a power not above nought
// grades nothing: a grade not yet set is all nought.
struct Grading {
    slopeR: f32
    slopeG: f32
    slopeB: f32
    offsetR: f32
    offsetG: f32
    offsetB: f32
    powerR: f32
    powerG: f32
    powerB: f32
    saturation: f32
    contrast: f32
    temperature: f32
    tint: f32
    table: u64
}

// A camera's screen-space ambient occlusion (ADR-0051, D327), on the same
// entity as its camera: the light a point takes from all around (the sky's
// and the ground's, its picture's, a reflection probe's) less where the
// surfaces within `radius` meters of it hide what is above it, the hiding
// taken `intensity` times (one as found, nought none). A radius or an
// intensity not above nought occludes nothing; the direct light of the
// sun and the lamps is never occluded here, since their shadows are.
struct AmbientOcclusion {
    radius: f32
    intensity: f32
}

// A camera's bloom (ADR-0051, D328), on the same entity as its camera: the
// scene's light spread wide around where it is, as a lens and an eye
// spread it, before the grade and the tonemapper; `intensity` of it (a
// fraction, nought to one) mixed with the light as it is. An intensity
// not above nought spreads none.
struct Bloom {
    intensity: f32
}

// A camera's screen-space reflections (ADR-0051, D331), on the same entity
// as its camera: a smooth surface reflects what the view saw the frame
// before where its reflection meets it, within `distance` meters, in
// place of the sky's picture or a probe's, fading as the surface roughens
// and toward the view's edges. A distance not above nought reflects
// nothing; so does a view not antialiased over time, which has no frame
// before to read.
struct ScreenSpaceReflections {
    distance: f32
}

// A camera's motion blur (ADR-0051, D334), on the same entity as its
// camera: what moves across the view is smeared along its motion as a
// camera's shutter open for `shutter` of each frame's time would smear it
// (a half is a 180 degree shutter), what stands in front kept sharp over
// what moves behind it. A shutter not above nought blurs nothing; one past
// a whole frame is taken as a whole frame.
struct MotionBlur {
    shutter: f32
}

// A camera's depth of field (ADR-0051, D336), on the same entity as its
// camera: what lies `focus` meters ahead is sharp, and what lies nearer
// or farther blurs into discs as a lens of the camera's field of view
// on a full-frame sensor, opened to the f-number `aperture`, would blur
// it (smaller numbers blur more). A focus or an aperture not above
// nought blurs nothing.
struct DepthOfField {
    focus: f32
    aperture: f32
}

// A camera's contact shadows (ADR-0051, D338), on the same entity as its
// camera: where something the view sees stands within `length` meters of
// a point toward the sun, the point is shaded from the sun, so the small
// shadows where things touch, which the shadow maps are too coarse to
// hold, are drawn. A length not above nought draws none.
struct ContactShadows {
    length: f32
}

// A camera's exposure metered from what it sees (ADR-0051, ADR-0047), on
// the same entity as its camera, whose `exposure` it starts from: the
// frame's light measured in a histogram of its luminance, the darkest
// `low` and the brightest past `high` of its pixels (fractions, nought to
// one) left out, the rest averaged into an EV100 less `compensation`
// stops, kept between `minimum` and `maximum`, and reached at `brighten`
// EV a second when the picture must brighten and `darken` when it must
// darken; at once when the metering starts or the eye cuts away. The
// middle of the picture counts more by `centered` (nought to one): at one,
// a pixel in the middle counts sixteen times one in a corner (D345). One
// whose maximum is not above its minimum meters nothing. Without one, the
// camera's `exposure` holds.
struct AutoExposure {
    minimum: f32
    maximum: f32
    brighten: f32
    darken: f32
    compensation: f32
    low: f32
    high: f32
    centered: f32
}

// The sun (ADR-0051's directional light), on any entity: light arriving
// along the direction (`directionX`, `directionY`, `directionZ`), the way
// it travels, `illuminance` lux on a surface facing it (about 100,000 at
// noon), in `color` (0xRRGGBBAA, sRGB; alpha unused). `angle` is the
// angle its disc spans, in radians (the Sun's is 0.0093, half a degree; at
// most 0.35), which widens its shadows away from their casters where the
// view's shadows harden at contact (D347); nought is a point. A game
// declares at most one sun; without one, a sun at noon, the Sun's size,
// lights the World.
struct Sun {
    directionX: f32
    directionY: f32
    directionZ: f32
    illuminance: f32
    color: u32
    angle: f32
}

// The sky's light, arriving from above the horizon (ADR-0051's ambient
// term): `luminance` candela per square meter (about 5,000 on a clear
// day), in `color`. From below it comes what the ground gives back of the
// sun's light and the sky's (D304): `ground` is its albedo, 0xRRGGBBAA in
// sRGB (alpha unused), and nought gives nothing back. A game declares at
// most one; without one, a clear day's: 5,000 in a clear blue
// (0x8FB8EBFF) over a ground giving back a fifth (0x7C7C7CFF). An
// `environment` is a picture of the sky all around (D322): the game texture
// a Radiance picture cooked as an environment is (its identity, as a
// material names a texture), seen behind everything and lighting and
// reflected by every surface, its light times `luminance` in `color`; the
// picture's lower half is then the ground, and `ground` gives nothing.
// Nought, or a texture that is not an environment, is none.
struct Sky {
    luminance: f32
    color: u32
    ground: u32
    environment: u64
}

// A reflection probe (ADR-0051, D325), on any entity, at its pose: a box
// `halfX`, `halfY`, and `halfZ` meters from its middle to its sides along
// the World's axes, and what is seen from its middle, `environment`, a
// game texture cooked as an environment (D321), its light times
// `intensity` in candela per square meter. A model whose middle is in its
// box reflects it, each reflection projected onto the box, in place of
// the sky's picture; where boxes overlap, the higher `priority` wins, then
// the smaller box. Sides of nought, or no environment, are no probe.
struct ReflectionProbe {
    halfX: f32
    halfY: f32
    halfZ: f32
    intensity: f32
    priority: u32
    environment: u64
}

// A decal (ADR-0051, D339), on any entity, at its pose: a box `halfX`,
// `halfY`, and `halfZ` meters from its middle to its sides along the
// entity's axes, which lays `texture`, a game texture, over the surfaces
// within it, seen along its -Z as a projector would throw it: the
// texture's left to right along +X, bottom to top along +Y. Its color
// tints the texture (0xRRGGBBAA, sRGB), its alpha times the texture's
// covering what is under it, lit as that surface is. Where it covers, a
// `normal` texture (glTF's tangent space, green up the texture) bends the
// surface's normal, and a `roughness` above nought (at most one) is the
// surface's (D342); a normal of nought, or a roughness of nought, leaves
// the surface's. Where decals overlap, a later entity's lies over an
// earlier's. Sides of nought, or no texture, are no decal.
struct Decal {
    halfX: f32
    halfY: f32
    halfZ: f32
    color: u32
    texture: u64
    normal: u64
    roughness: f32
}

// A point light (ADR-0051), on any entity, at its pose: `lumens` of
// luminous power spread evenly (a lumen over 4π is a candela), reaching
// `range` meters, where it has faded to nought, in `color` (0xRRGGBBAA,
// sRGB; alpha unused). Lumens or a range of nought light nothing. With
// `shadows`, what stands between it and a surface shades it, for as many
// lights as the view's budget holds, those covering most of it first.
struct PointLight {
    lumens: f32
    range: f32
    color: u32
    shadows: bool
}

// A spot light (ADR-0051), on any entity, at its pose, shining along the
// pose's -Z (nought turn shines along -Z, as a camera looks): `lumens` as
// if all of them lay in its cone (a lumen over π is a candela, ADR-0051's
// documented approximation), full within `inner` radians of its axis and
// fading to nought at `outer`, reaching `range` meters, in `color`; with
// `shadows`, shadowed as a point light is.
struct SpotLight {
    lumens: f32
    range: f32
    inner: f32
    outer: f32
    color: u32
    shadows: bool
}

// A post process (ADR-0051's typed component in a camera's stack, D349),
// on the client's own player, as its camera is: the game's post-process
// material (SPEC-0026's `post_process` domain, D348) of the identity its
// `material` line gives it (nought for none), run at its material's
// insertion point, `weight` of the way (nought to one: nought runs
// nothing, so a fade is a weight that moves). A game may declare several,
// each a component of this type; at one insertion point they run in the
// order the game declares them.
struct PostProcess {
    material: u64
    weight: f32
}

// A particle emitter (ADR-0053, D352), on any entity, at its pose:
// particles drawn as quads facing the eye, of the game's surface material
// of the identity its `material` line gives it (nought for none: white),
// its base color and texture times their color, its emission added,
// unlit, laid over what is behind by their alpha, each a soft disc unless
// the texture's alpha shapes it, and faded where it meets what is behind
// (D353). `rate` a second, each living `lifetime` seconds, leaving at
// `speed` meters a second along the pose's +Y, within `spread` radians of
// it (pi: every way), from within `radius` meters of the pose; `sizeStart`
// meters across at birth and `sizeEnd` at death; `colorStart` and
// `colorEnd` (0xRRGGBBAA, sRGB, the alpha their opacity) between; pushed
// by the acceleration (meters a second squared: gravity is (0, -9.8, 0))
// and slowed by `drag` (a second); each one's life, speed, and size varied
// by up to `variation` of them (nought to one). Each time `bursts` moves,
// `burstCount` more leave at once. A nought `seed` takes one from the
// entity. Cosmetic: each client draws its own particles, and nothing in
// the World sees them.
struct ParticleEmitter {
    material: u64
    rate: f32
    lifetime: f32
    speed: f32
    spread: f32
    radius: f32
    sizeStart: f32
    sizeEnd: f32
    colorStart: u32
    colorEnd: u32
    accelerationX: f32
    accelerationY: f32
    accelerationZ: f32
    drag: f32
    variation: f32
    bursts: u32
    burstCount: u32
    seed: u32
}

// White: a surface, a sun, or a sky as it is.
const WHITE: u32 = 0xFFFFFFFF

// A linear channel's sRGB byte: nought to one, as the colors above hold
// it, rounded. Below nought is nought and above one is 255.
fn channel(linear: f32) -> u32 {
    if linear <= 0.0 {
        return u32(0)
    }
    if linear >= 1.0 {
        return u32(255)
    }
    if linear <= 0.0031308 {
        return u32(linear * 12.92 * 255.0 + 0.5)
    }
    // The power of 1/2.4 as the twelfth root's fifth power, the root by
    // Newton's method from one, which comes down to it within twelve steps.
    let root = 1.0
    let step = 0
    while step < 12 {
        let squared = root * root
        let eighth = squared * squared * squared * squared
        root = (11.0 * root + linear / (eighth * squared * root)) / 12.0
        step = step + 1
    }
    let fifth = root * root * root * root * root
    return u32((1.055 * fifth - 0.055) * 255.0 + 0.5)
}

// The color of a light at a color temperature (ADR-0051's Kelvin input,
// which derives a color and is never kept beside one): 0xRRGGBBFF in sRGB,
// for a light's `color`. A black body at `temperature` on Kim et al.'s fit of
// the Planckian locus, 1,667 to 25,000 K (outside, its nearer end), seen in
// linear Rec. 709 against one at 6,500 K, so 6,500 is white (D65), lower is
// warmer, higher is bluer; its brightest channel full, as a light's
// intensity is its lumens alone.
fn kelvin(temperature: f32) -> u32 {
    let t = temperature
    if t < 1667.0 {
        t = 1667.0
    }
    if t > 25000.0 {
        t = 25000.0
    }
    let k = 1000.0 / t
    let x = -3.0258469 * k * k * k + 2.1070379 * k * k + 0.2226347 * k + 0.24039
    if t <= 4000.0 {
        x = -0.2661239 * k * k * k - 0.2343589 * k * k + 0.8776956 * k + 0.17991
    }
    let y = 3.081758 * x * x * x - 5.8733867 * x * x + 3.75112997 * x - 0.37001483
    if t <= 2222.0 {
        y = -1.1063814 * x * x * x - 1.3481102 * x * x + 2.18555832 * x - 0.20219683
    } else if t <= 4000.0 {
        y = -0.9549476 * x * x * x - 1.37418593 * x * x + 2.09137015 * x - 0.16748867
    }
    // Its XYZ at a luminance of one, then Rec. 709 over 6,500 K's.
    let big = x / y
    let small = (1.0 - x - y) / y
    let red = (3.2404542 * big - 1.5371385 - 0.4985314 * small) / 1.0426302
    let green = (-0.969266 * big + 1.8760108 + 0.041556 * small) / 0.98378255
    let blue = (0.0556434 * big - 0.2040259 + 1.0572252 * small) / 1.0350764
    let most = red
    if green > most {
        most = green
    }
    if blue > most {
        most = blue
    }
    let rgb = (channel(red / most) << u32(24)) | (channel(green / most) << u32(16)) | (channel(blue / most) << u32(8))
    return rgb | u32(0xFF)
}
