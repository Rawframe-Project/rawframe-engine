module rawframe.sound

// Sound as World data: which entity sounds and which one hears.
// A game declares components of these types; clients play them, and a
// server carries them as it carries any other value, with no sound of its
// own.

// Despawn policies: what becomes of an emitter's continuous sound when the
// emitter goes away.
const STOP: u8 = 0
const FADE_OUT: u8 = 1
const DETACH_TO_COMPLETION: u8 = 2

// An entity that sounds: the declared sound, by the identity the game's
// `sound` line gives it, from where the entity's pose puts it. While
// `playing`, the sound plays on; each step `cue` takes plays it once more
// to its end. `despawn` is one of the policies above.
struct Emitter {
    sound: u64
    cue: u32
    playing: bool
    despawn: u8
}

// Who hears, from where its pose puts it and facing as the pose turns it.
// Exactly one listener is active at a time; two is no listener at all.
struct Listener {
    active: bool
}

// The roles of a mixer's buses a player's volume binds to:
// the master, music, effects, voices, the interface's, and ambience.
const MASTER: u32 = 1
const MUSIC: u32 = 2
const EFFECTS: u32 = 3
const VOICE: u32 = 4
const INTERFACE: u32 = 5
const AMBIENCE: u32 = 6

extern fn Sound.volume(role: u32, decibels: f32)

// The player's volume for the bus of `role`, `decibels` on top of
// the bus's own, from -80 to +12, as a settings slider sets it; nought, as
// at first, leaves the bus as the mixer document says. A client's present
// systems set it for the client's own hearing; in every simulation it does
// nothing.
fn volume(role: u32, decibels: f32) {
    Sound.volume(role, decibels)
}
