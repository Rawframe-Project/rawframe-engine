module rawframe.studio

// Studio extensions (SPEC-0051 Part 7, D874): a Kest program under a game's
// `extensions/` directory, run by the authoring session as untrusted code
// with these doors and no others, so opening a game never runs its code
// with the tool's authority. An extension offers commands; a command
// changes the scene only by the operations it stages here, which the
// session applies as one atomic step of the scene's history, as Studio's
// own edits are, and which `authoring.extension` runs without Studio.
//
// The session first calls the extension's `extend()`, in which it names
// each command with `command`; then a command's function, by the
// name given, with nothing, each time it is run. A game's programs are
// offered none of these doors.

// The doors, each called through the function below it.
extern fn Studio.command(name: text, run: text)

extern fn Edit.chosen() -> u32
extern fn Edit.number(index: u32, component: text, field: text) -> f64
extern fn Edit.set_number(index: u32, component: text, field: text, value: f64)
extern fn Edit.make(name: text) -> u32
extern fn Edit.add(made: u32, component: text)
extern fn Edit.set_made(made: u32, component: text, field: text, value: f64)

// Offers a command, by the name an author finds it by and the extension's
// function that runs it. Only in `extend()`.
fn command(name: text, run: text) {
    Studio.command(name, run)
}

// How many entities were chosen when the command was run.
fn chosen() -> u32 {
    return Edit.chosen()
}

// A number field of the `index`th chosen entity, by its component's name
// as the scene records it and the field's path (`x`, `position.y`);
// nought where it has no such field.
fn number(index: u32, component: text, field: text) -> f64 {
    return Edit.number(index, component, field)
}

// Stages a number field of the `index`th chosen entity.
fn set_number(index: u32, component: text, field: text, value: f64) {
    Edit.set_number(index, component, field, value)
}

// Stages a new entity of this name, answering its place among those this
// run makes, from nought, for `add` and `set_made`.
fn make(name: text) -> u32 {
    return Edit.make(name)
}

// Stages a component on an entity this run made, and a number field of it.
fn add(made: u32, component: text) {
    Edit.add(made, component)
}

fn set_made(made: u32, component: text, field: text, value: f64) {
    Edit.set_made(made, component, field, value)
}
