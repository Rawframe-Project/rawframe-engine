module rawframe.ui

// The UI as World data: a UI element is an
// entity's component of this type, a node of its client's UI tree. A game
// declares components of it, usually presentation components its present
// systems write (`presentation <node>... on player` for a player's HUD),
// and its UI document (`ui <file>`) puts each node inside another:
// the parent is that component on the same entity, or else on the
// client's player. The document also starts each presentation component
// as it says, so a present system writes only what changes. A node inside
// none is a root of its player's view, laid out in the view's rectangle,
// those of one view drawn in `order` (then by entity) over the scene and
// the canvas. Logical pixels, y down.
//
// Sizes are the Scale+Offset: a share of the parent's content box
// plus pixels; a size of nought and nought is automatic, fitting what the
// node holds. A node lays its children out in a row or a column (`direction`)
// with `gap` pixels between them, along the row by `justify`, across it by
// `alignItems`; as a child, it grows into room left by `grow` and gives way
// when there is too little by `shrink` (nought keeps its size), and may
// align itself across. `padding`, `margin`, and `border` are pixels on every
// side. An `absolute` node is out of its parent's row: its start and top
// edges at `x` and `y` (Scale+Offset) from its parent's padding box's, then
// moved back by `anchorX` and `anchorY` of its own size, so 0.5, 0.5 centers
// it there.
//
// It shows a rounded box: `fill` and `borderColor`, 0xRRGGBBAA, sRGB (an
// alpha of nought draws nothing), corners of `radius` pixels, and with
// `clip` its children are cut to it. Over its fill it may show an `image`,
// a texture by the identity the game's `texture` line gives it,
// stretched over the box, or in nine slices whose corners keep
// `imageSlice` of the texture's pixels each way at a pixel each, tinted by
// `imageTint` (nought draws it as it is). Under it the box may cast a
// shadow, as CSS's box-shadow: `shadowColor` (nought casts none),
// `shadowX` and `shadowY` pixels off, blurred over `shadowBlur` pixels. Over
// its fill it may paint a gradient from `gradientFrom` to
// `gradientTo` (0xRRGGBBAA): LINEAR along `gradientAngle` degrees clockwise
// from toward the top, as CSS's linear-gradient, or RADIAL out from its
// center to its farthest corner.
//
// It may show words: `text` names a label by the identity the game's
// `label` line gives it, a key of one of its string tables in the player's
// locale, whose arguments, if its message reads them, are `textValue` and
// `textSecond`, in the order the label line names them. The
// words are in `font`, a font by the identity a `font` line gives it (nought
// for the game's first), `textSize` pixels to the em (nought for 16), of
// `textColor` (0xRRGGBBAA), their lines at the start, center, or end
// (`textAlign`), wrapped to the node's width unless NO_WRAP. A node with
// words is sized by them unless its size says otherwise, and lays out no
// children of its own, which would leave it no size: words and
// other nodes sit side by side inside a node that holds both.
//
// A press of the mouse or a touch is the UI's where it lands on a
// node whose `hit` is HIT_SELF, and then no game action sees it, nor its
// release; the sample function reads that node's `press` through
// `input.uiPressed()`. A node's `hit` of nought passes presses on to its
// children and, past them, to the game; HIT_NONE leaves it and its
// children out. A node may root a `layer`, drawn and hit above the content
// it is in: a dialog's (ACTIVATION), a MODAL one that presses missing it
// reach nothing below, or an OVERLAY above them all. A zeroed node, as
// presentation attaches it without a document, is empty, draws nothing,
// and passes every press on.
//
// A node whose `edit` is not NO_EDIT is a text field: a press on it
// gives it the keyboard, the caret where the press landed, and a press
// anywhere else takes it away, as Escape does. It shows what is typed into
// it, in its text look, not its label; at most `editLimit` bytes (nought
// for 252), the input method's composition inline. Enter in an EDIT_LINE
// field gives its text to the sample function (`input.uiSubmitted()`,
// `input.uiTyped()`) and lets the keyboard go; in an EDIT_MESSAGE field it
// gives the text, empties the field, and keeps the keyboard; in EDIT_LINES
// it types a line break. While a field holds the keyboard, the keys type
// and reach no action of a context gated by text editing.
//
// A node's `style` names a class of the game's styles document (the
// `styles` line) by its identity, nought for none: the class gives
// the node every part of its look the node leaves at nought (its fill,
// border color, radius, clip, image tint, shadow, gradient), as it is now:
// hovered under the mouse, pressed while a press on it is held, focused
// while it holds focus, each moving as the class's transitions say. An
// unstyled node holding focus is ringed.
//
// A node whose `scroll` is not NO_SCROLL scrolls its children along those
// axes: it clips them to its padding box, may be smaller than they
// are, and a wheel turned over it moves them, easing, while it can move
// that way; children that should keep their sizes set `shrink` to nought.
//
// A node whose `range` is not NO_RANGE is a slider: its value lies
// from `rangeMinimum` to `rangeMaximum` on whole `rangeStep`s from the
// minimum (nought for any value), the minimum at its start, or at its
// bottom if vertical. A press on it moves the value a tenth of its span
// (or a step, if more) toward the press, and a drag moves it with the
// pointer, from where the node inside it whose `thumb` is one was grabbed
// (none, and the value follows the pointer). Holding focus, it moves a
// step for each navigation move along it, and a screen reader steps and
// sets it too. Its `rangeValue` is what it
// starts at; the value the player moved it to stays until `rangeValue` is
// written anew. A present system reads it by its `press` with
// `ui.value(press)` and places the thumb and sizes a fill from it: a
// thumb `absolute` at `xScale` and `anchorX` both the value's share of
// the range lies on the track as the drag expects.
//
// A node whose `check` is not NO_CHECK is checked and unchecked: a
// CHECKBOX or a SWITCH by each press on it (a screen reader's, or
// navigation's activation, too), a RADIO checked by a press and unchecked
// as another RADIO beside it, under the same parent, is checked. It
// starts as `checked` (one for checked) says, and what the player made it
// stays until `checked` is written anew. `ui.value(press)` reads one for
// checked and nought for not; its style class's `checked` look shows it,
// and assistive technology reads it as a check box, a switch, or a radio
// button. A checkable node and a slider are named to assistive technology
// by their label's words, which they do not draw.
//
// A node whose `popup` is not NO_POPUP is placed beside its parent,
// as a tooltip or a menu is: on that side, centered along it, `margin`
// pixels away, flipped to the other side where the view leaves no room,
// and taking no room inside its parent; usually an OVERLAY `layer`, drawn
// over all. A game shows one while it wants it, as a tooltip while
// `ui.hovered()` is its parent's press, and empties it otherwise. A popup
// with words and nothing to press reads as a tooltip.
//
// A node whose `disabled` is one takes nothing: a press on it is
// the UI's and reaches no game action, but gives no press code, focuses
// no field, checks nothing, and moves no slider; navigation passes it by.
// Its style class's `disabled` look shows it, over every other state's,
// and assistive technology reads it as disabled.
//
// A slider or a checkable node whose `kept` is one is the player's
// setting: what the player makes it is kept on their machine,
// under its component's name, where the client keeps the player's
// settings (`ui.kept`), and it starts as kept on the next run, as if the
// player had moved it there; `ui.value(press)` reads it. A client
// keeping none, and the web's, starts it as the node says.
struct Node {
    widthScale: f32
    widthOffset: f32
    heightScale: f32
    heightOffset: f32
    direction: u32
    justify: u32
    alignItems: u32
    alignSelf: u32
    gap: f32
    grow: f32
    shrink: f32
    padding: f32
    margin: f32
    border: f32
    absolute: u32
    xScale: f32
    xOffset: f32
    yScale: f32
    yOffset: f32
    anchorX: f32
    anchorY: f32
    fill: u32
    borderColor: u32
    radius: f32
    clip: u32
    order: i32
    image: u64
    imageTint: u32
    imageSlice: f32
    shadowColor: u32
    shadowX: f32
    shadowY: f32
    shadowBlur: f32
    gradientKind: u32
    gradientAngle: f32
    gradientFrom: u32
    gradientTo: u32
    text: u64
    textValue: i64
    textSecond: i64
    font: u64
    textSize: f32
    textColor: u32
    textAlign: u32
    textWrap: u32
    press: i64
    hit: u32
    layer: u32
    edit: u32
    editLimit: u32
    style: u64
    scroll: u32
    range: u32
    rangeMinimum: f32
    rangeMaximum: f32
    rangeStep: f32
    rangeValue: f32
    thumb: u32
    check: u32
    checked: u32
    popup: u32
    disabled: u32
    kept: u32
}

// A node's `scroll`.
const NO_SCROLL: u32 = 0
const SCROLL_HORIZONTAL: u32 = 1
const SCROLL_VERTICAL: u32 = 2
const SCROLL_BOTH: u32 = 3

// A node's `range`.
const NO_RANGE: u32 = 0
const RANGE_HORIZONTAL: u32 = 1
const RANGE_VERTICAL: u32 = 2

// A node's `check`.
const NO_CHECK: u32 = 0
const CHECKBOX: u32 = 1
const SWITCH: u32 = 2
const RADIO: u32 = 3

// A node's `popup`: beside its parent, below, above, at its start or end,
// or on its center.
const NO_POPUP: u32 = 0
const POPUP_BELOW: u32 = 1
const POPUP_ABOVE: u32 = 2
const POPUP_START: u32 = 3
const POPUP_END: u32 = 4
const POPUP_CENTER: u32 = 5

// A node's `direction`.
const ROW: u32 = 0
const ROW_REVERSE: u32 = 1
const COLUMN: u32 = 2
const COLUMN_REVERSE: u32 = 3

// A node's `justify`: where its children sit along its row.
const START: u32 = 0
const END: u32 = 1
const CENTER: u32 = 2
const SPACE_BETWEEN: u32 = 3
const SPACE_AROUND: u32 = 4
const SPACE_EVENLY: u32 = 5

// A node's `alignItems` and `alignSelf`: where children sit across its row.
// AUTO is a child's parent's choice; as a parent's, it stretches.
const AUTO: u32 = 0
const STRETCH: u32 = 1
const ALIGN_START: u32 = 2
const ALIGN_END: u32 = 3
const ALIGN_CENTER: u32 = 4

// A node's `gradientKind`: none, along a line, or outward from its center.
const NO_GRADIENT: u32 = 0
const LINEAR: u32 = 1
const RADIAL: u32 = 2
// A node's `textAlign`, and its `textWrap`.
const TEXT_START: u32 = 0
const TEXT_CENTER: u32 = 1
const TEXT_END: u32 = 2
const WRAP: u32 = 0
const NO_WRAP: u32 = 1

// A node's `hit`: presses pass on to its children and the game, are its
// own, or pass it and its children by.
const HIT_CHILDREN: u32 = 0
const HIT_SELF: u32 = 1
const HIT_NONE: u32 = 2
// A node's `layer`.
const NO_LAYER: u32 = 0
const ACTIVATION: u32 = 1
const MODAL: u32 = 2
const OVERLAY: u32 = 3

// A node's `edit`.
const NO_EDIT: u32 = 0
const EDIT_LINE: u32 = 1
const EDIT_MESSAGE: u32 = 2
const EDIT_LINES: u32 = 3

// What a player typed into a field: `length` bytes of UTF-8 in `bytes`.
// As a component on a node's entity that the UI document has the node
// show (`shows`), the node shows its words in its text look, in place of
// its label, while it holds any: a sign, a name, a line of chat.
struct Typed {
    length: u32
    bytes: [u8; 252]
}

extern fn UI.hovered() -> i64
extern fn UI.value(press: i64) -> f32

// The `press` of the UI node under the client's mouse, where a press would
// land, or nought for none: a present system lights it. Nought in
// every simulation, on a server and in a client's prediction, and for any
// local player but the first, whose mouse it is.
fn hovered() -> i64 {
    return UI.hovered()
}

// The value of the slider whose `press` is `press` in the client's view,
// as the player moved it, or one if the checkable node whose
// `press` it is is checked; nought for neither, and in every
// simulation.
fn value(press: i64) -> f32 {
    return UI.value(press)
}
