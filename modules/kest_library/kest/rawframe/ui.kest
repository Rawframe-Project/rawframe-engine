module rawframe.ui

// The UI as World data (ADR-0034, SPEC-0030, D376): a UI element is an
// entity's component of this type, a node of its client's UI tree. A game
// declares components of it, usually presentation components its present
// systems write (`presentation <node>... on player` for a player's HUD),
// and a `ui <node> in <parent>` line for each node inside another: the
// parent is that component on the same entity, or else on the client's
// player. A node with no such line is a root of its player's view, laid
// out in the view's rectangle, those of one view drawn in `order` (then by
// entity) over the scene and the canvas. Logical pixels, y down.
//
// Sizes are SPEC-0030's Scale+Offset: a share of the parent's content box
// plus pixels; a size of nought and nought is automatic, fitting what the
// node holds. A node lays its children out in a row or a column (`direction`)
// with `gap` pixels between them, along the row by `justify`, across it by
// `alignItems`; as a child, it grows into room left by `grow` and gives way
// when there is too little by `shrink` (nought keeps its size), and may
// align itself across. `padding`, `margin`, and `border` are pixels on every
// side. An `absolute` node is out of its parent's row: its start and top
// edges at `x` and `y` (Scale+Offset) from its parent's padding box's, then
// moved back by `anchorX` and `anchorY` of its own size, so 0.5, 0.5 centers
// it there.
//
// It shows a rounded box: `fill` and `borderColor`, 0xRRGGBBAA, sRGB (an
// alpha of nought draws nothing), corners of `radius` pixels, and with
// `clip` its children are cut to it. Over its fill it may show an `image`
// (D378), a texture by the identity the game's `texture` line gives it,
// stretched over the box, or in nine slices whose corners keep
// `imageSlice` of the texture's pixels each way at a pixel each, tinted by
// `imageTint` (nought draws it as it is). Under it the box may cast a
// shadow (D381), as CSS's box-shadow: `shadowColor` (nought casts none),
// `shadowX` and `shadowY` pixels off, blurred over `shadowBlur` pixels. Over
// its fill it may paint a gradient (D382) from `gradientFrom` to
// `gradientTo` (0xRRGGBBAA): LINEAR along `gradientAngle` degrees clockwise
// from toward the top, as CSS's linear-gradient, or RADIAL out from its
// center to its farthest corner.
//
// It may show words (D386): `text` names a label by the identity the game's
// `label` line gives it, a key of one of its string tables in the player's
// locale, whose one argument, if its message reads one, is `textValue`. The
// words are in `font`, a font by the identity a `font` line gives it (nought
// for the game's first), `textSize` pixels to the em (nought for 16), of
// `textColor` (0xRRGGBBAA), their lines at the start, center, or end
// (`textAlign`), wrapped to the node's width unless NO_WRAP. A node with
// words is sized by them unless its size says otherwise; its children
// inherit their look.
//
// A press of the mouse or a touch (D421) is the UI's where it lands on a
// node whose `hit` is HIT_SELF, and then no game action sees it, nor its
// release; the sample function reads that node's `press` through
// `input.uiPressed()`. A node's `hit` of nought passes presses on to its
// children and, past them, to the game; HIT_NONE leaves it and its
// children out. A node may root a `layer`, drawn and hit above the content
// it is in: a dialog's (ACTIVATION), a MODAL one that presses missing it
// reach nothing below, or an OVERLAY above them all. A zeroed node, as
// presentation attaches it, is empty, draws nothing, and passes every
// press on.
//
// A node whose `edit` is not NO_EDIT is a text field (D426): a press on it
// gives it the keyboard, the caret where the press landed, and a press
// anywhere else takes it away, as Escape does. It shows what is typed into
// it, in its text look, not its label; at most `editLimit` bytes (nought
// for 252), the input method's composition inline. Enter in an EDIT_LINE
// field gives its text to the sample function (`input.uiSubmitted()`,
// `input.uiTyped()`) and lets the keyboard go; in an EDIT_MESSAGE field it
// gives the text, empties the field, and keeps the keyboard; in EDIT_LINES
// it types a line break. While a field holds the keyboard, the keys type
// and reach no action of a context gated by text editing (SPEC-0029).
struct Node {
    widthScale: f32
    widthOffset: f32
    heightScale: f32
    heightOffset: f32
    direction: u32
    justify: u32
    alignItems: u32
    alignSelf: u32
    gap: f32
    grow: f32
    shrink: f32
    padding: f32
    margin: f32
    border: f32
    absolute: u32
    xScale: f32
    xOffset: f32
    yScale: f32
    yOffset: f32
    anchorX: f32
    anchorY: f32
    fill: u32
    borderColor: u32
    radius: f32
    clip: u32
    order: i32
    image: u64
    imageTint: u32
    imageSlice: f32
    shadowColor: u32
    shadowX: f32
    shadowY: f32
    shadowBlur: f32
    gradientKind: u32
    gradientAngle: f32
    gradientFrom: u32
    gradientTo: u32
    text: u64
    textValue: i64
    font: u64
    textSize: f32
    textColor: u32
    textAlign: u32
    textWrap: u32
    press: i64
    hit: u32
    layer: u32
    edit: u32
    editLimit: u32
}

// A node's `direction`.
const ROW: u32 = 0
const ROW_REVERSE: u32 = 1
const COLUMN: u32 = 2
const COLUMN_REVERSE: u32 = 3

// A node's `justify`: where its children sit along its row.
const START: u32 = 0
const END: u32 = 1
const CENTER: u32 = 2
const SPACE_BETWEEN: u32 = 3
const SPACE_AROUND: u32 = 4
const SPACE_EVENLY: u32 = 5

// A node's `alignItems` and `alignSelf`: where children sit across its row.
// AUTO is a child's parent's choice; as a parent's, it stretches.
const AUTO: u32 = 0
const STRETCH: u32 = 1
const ALIGN_START: u32 = 2
const ALIGN_END: u32 = 3
const ALIGN_CENTER: u32 = 4

// A node's `gradientKind`: none, along a line, or outward from its center.
const NO_GRADIENT: u32 = 0
const LINEAR: u32 = 1
const RADIAL: u32 = 2
// A node's `textAlign`, and its `textWrap`.
const TEXT_START: u32 = 0
const TEXT_CENTER: u32 = 1
const TEXT_END: u32 = 2
const WRAP: u32 = 0
const NO_WRAP: u32 = 1

// A node's `hit`: presses pass on to its children and the game, are its
// own, or pass it and its children by.
const HIT_CHILDREN: u32 = 0
const HIT_SELF: u32 = 1
const HIT_NONE: u32 = 2
// A node's `layer`.
const NO_LAYER: u32 = 0
const ACTIVATION: u32 = 1
const MODAL: u32 = 2
const OVERLAY: u32 = 3

// A node's `edit`.
const NO_EDIT: u32 = 0
const EDIT_LINE: u32 = 1
const EDIT_MESSAGE: u32 = 2
const EDIT_LINES: u32 = 3

// What a player typed into a field: `length` bytes of UTF-8 in `bytes`.
struct Typed {
    length: u32
    bytes: [u8; 252]
}

extern fn UI.hovered() -> i64

// The `press` of the UI node under the client's mouse, where a press would
// land, or nought for none (D422): a present system lights it. Nought in
// every simulation, on a server and in a client's prediction, and for any
// local player but the first, whose mouse it is.
fn hovered() -> i64 {
    return UI.hovered()
}
