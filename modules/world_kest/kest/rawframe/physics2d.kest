module rawframe.physics2d

// The components of 2D physics (SPEC-0037, D33), as the engine lays them out:
// a game with a `physics2d` line has them, and a program that reads or
// writes them imports this module. An entity with a Body2D, a Pose2D, and a
// Velocity2D has a body. Systems before `rawframe.physics2d.step` push bodies
// (write an Impulse2D, or set a Pose2D or a Velocity2D outright); systems
// after it read where they went. An entity that also has a Contact2D is told
// what its body touched. Meters, seconds, kilograms, radians.

import rawframe.replication
import rawframe.world

// Body2D.motion
const STATIC: u8 = 0
const KINEMATIC: u8 = 1
const DYNAMIC: u8 = 2

// Body2D.shape: a circle of radius `width`, a box of half sides `width` and
// `height`, or an upright capsule of radius `width` whose two centers are
// `height` above and below the origin.
const CIRCLE: u8 = 0
const BOX: u8 = 1
const CAPSULE: u8 = 2

// How the body is made; changing it makes the body again where it is.
struct Body2D {
    motion: u8
    shape: u8
    fixedRotation: bool
    bullet: bool
    // Detects what overlaps it and pushes nothing: a trigger zone.
    sensor: bool
    // Its collision class's identity, as the game's collision lines declare
    // it; nought is none.
    collisionClass: u64
    width: f32
    height: f32
    density: f32
    friction: f32
    restitution: f32
    linearDamping: f32
    angularDamping: f32
}

// The origin, and the rotation as a cosine and a sine. Nought and nought is
// no rotation.
struct Pose2D {
    x: f64
    y: f64
    c: f32
    s: f32
}

struct Velocity2D {
    x: f32
    y: f32
    angular: f32
}

// Applied once by the next step, then cleared.
struct Impulse2D {
    x: f32
    y: f32
    angular: f32
}

// Written by every step. Counts of the contacts touching now, begun, and
// ended this step, and likewise of overlaps with sensors (on the sensor and
// on what is inside it); the other body of the hardest contact begun this
// step, its closing speed, and the normal from this body toward it; and the
// first body that began to overlap this one this step. An Entity is the
// null one when nothing began.
struct Contact2D {
    touching: u32
    began: u32
    ended: u32
    overlapping: u32
    entered: u32
    exited: u32
    hit: world.Entity
    hitSpeed: f32
    hitNormalX: f32
    hitNormalY: f32
    visitor: world.Entity
}

// What a ray found: the closest body along it, where, the surface's normal
// there, and how far along the ray (0 at its origin, 1 at its end). A ray
// that starts inside a body hits it `inside`, at its origin, with no normal.
// A ray cast back in time hits a body `discontinuous` when the body has no
// unbroken trail back to then, and so was tried where it is now.
struct RayHit2D {
    hit: bool
    inside: bool
    discontinuous: bool
    entity: world.Entity
    x: f64
    y: f64
    normalX: f32
    normalY: f32
    fraction: f32
}

extern fn Physics2D.castRay(originX: f64, originY: f64, towardX: f32, towardY: f32) -> RayHit2D

// The closest body along the ray from the origin to the origin plus
// `toward`, where bodies were after the last step; sensors included.
fn castRay(originX: f64, originY: f64, towardX: f32, towardY: f32) -> RayHit2D {
    return Physics2D.castRay(originX, originY, towardX, towardY)
}

extern fn Physics2D.castRayAt(originX: f64, originY: f64, towardX: f32, towardY: f32,
                              seen: replication.Perception) -> RayHit2D

// The same ray against every body where it was at the moment a player saw
// (SPEC-0041 lag compensation): what the player shot at, not where it has
// gone since. The moment is clamped into the kept history.
fn castRayAt(originX: f64, originY: f64, towardX: f32, towardY: f32, seen: replication.Perception) -> RayHit2D {
    return Physics2D.castRayAt(originX, originY, towardX, towardY, seen)
}
