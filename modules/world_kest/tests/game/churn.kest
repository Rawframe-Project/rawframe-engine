module churn

import rawframe.world

// A thing to make and unmake.
struct Mark {
    at: u32
}

extern fn Mark.insert(entity: world.Entity, value: Mark)
extern fn Mark.remove(entity: world.Entity)

// Structural doors: an entity made and unmade in one run, a mark inserted
// and removed twice over on it, a component removed that was never there,
// and an entity of the World destroyed twice, each skipped at the barrier.
fn churn(count: i32, marks: [Mark], entities: [world.Entity]) {
    let i = 0
    while i < count {
        let made = world.create()
        Mark.insert(made, Mark(u32(1)))
        Mark.insert(made, Mark(u32(2)))
        Mark.remove(made)
        Mark.remove(made)
        world.destroy(entities[i])
        world.destroy(entities[i])
        Mark.insert(entities[i], Mark(marks[i].at + u32(1)))
        i = i + 1
    }
}
