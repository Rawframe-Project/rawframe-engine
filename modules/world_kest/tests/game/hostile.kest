module hostile

// What a broken or hostile program could pass a door: NaN, the infinities,
// the largest and smallest numbers, a negative nought, negative sizes,
// classes and indices past any there are, and moments far from any kept.

import rawframe.replication

// How many calls a poke made on its last run, and how many met something.
struct Poke {
    calls: u32
    hits: u32
}

// Hostile kinds of number, then a plain one.
const KINDS: i32 = 10

fn hostile(kind: i32) -> f64 {
    let zero: f64 = 0.0
    if kind == 0 {
        return zero / zero
    }
    if kind == 1 {
        return 1.0 / zero
    }
    if kind == 2 {
        return 0.0 - 1.0 / zero
    }
    if kind == 3 {
        return 1e300
    }
    if kind == 4 {
        return 0.0 - 1e300
    }
    if kind == 5 {
        return 1e-300
    }
    if kind == 6 {
        return zero * (0.0 - 1.0)
    }
    if kind == 7 {
        return 0.0 - 5.0
    }
    if kind == 8 {
        return 4e38
    }
    return 1.0
}

// Argument `position` of a call whose argument `at` is hostile, or all of
// them when `at` is past the last.
fn arg(position: i32, at: i32, last: i32, kind: i32) -> f64 {
    if position == at || at > last {
        return hostile(kind)
    }
    return 1.0
}

fn among(kind: i32) -> u64 {
    if kind % 3 == 0 {
        return u64(0)
    }
    if kind % 3 == 1 {
        return 0xdeadbeef
    }
    return 0xffffffffffffffff
}

fn index(kind: i32) -> u32 {
    if kind % 3 == 0 {
        return u32(0)
    }
    if kind % 3 == 1 {
        return u32(1)
    }
    return 0xffffffff
}

fn moment(kind: i32) -> replication.Perception {
    if kind % 3 == 0 {
        return replication.Perception(u64(0), u16(0), u32(0))
    }
    if kind % 3 == 1 {
        return replication.Perception(0xffffffffffffffff, u16(65535), u32(7))
    }
    return replication.Perception(u64(3), u16(32768), 0xffffffff)
}
