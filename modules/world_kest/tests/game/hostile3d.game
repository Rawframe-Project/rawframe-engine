# Every 3D physics door asked with hostile values after each step, beside a
# floor and a falling ball.
program hostile3d.kest
physics3d gravity 0 -10 0

component 13fbb802-8fea-4b06-a6c7-01d749ff4b0e hostile.poke hostile.Poke

system hostile.poke simulation poke3 write hostile.poke after rawframe.physics3d.step

spawn 1 rawframe.physics3d.body motion=0 shape=1 width=10 height=0.5 depth=10 rawframe.physics3d.pose rawframe.physics3d.velocity
spawn 1 rawframe.physics3d.body motion=2 shape=0 width=0.4 density=1 rawframe.physics3d.pose y=3 rawframe.physics3d.velocity
spawn 1 hostile.poke
