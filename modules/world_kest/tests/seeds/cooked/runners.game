{"animators":[],"files":[{"path":"jump.sound","text":"{\n  \"kind\": \"audio.sound\",\n  \"formatVersion\": 1,\n  \"variants\": [\n    {\n      \"resource\": \"1274499474142e189b67a3b499591324\"\n    }\n  ],\n  \"pitch\": {\n    \"minimum\": 0.95,\n    \"maximum\": 1.05\n  },\n  \"bus\": \"691c5abeb88d55ee\",\n  \"concurrency\": \"jumps\",\n  \"attenuation\": {\n    \"minimumDistance\": 2,\n    \"maximumDistance\": 30,\n    \"falloff\": \"linear\"\n  }\n}\n"},{"path":"runners.actions","text":"{\n  \"kind\": \"input.actions\",\n  \"formatVersion\": 1,\n  \"actions\": [\n    {\n      \"actionId\": \"9182d0b16cbd7c9c\",\n      \"name\": \"run\",\n      \"valueType\": \"axis1d\",\n      \"displayName\": \"Run\",\n      \"bindings\": [\n        {\n          \"device\": \"keyboard\",\n          \"pair\": {\n            \"negative\": \"key_a\",\n            \"positive\": \"key_d\"\n          }\n        },\n        {\n          \"device\": \"gamepad\",\n          \"pair\": {\n            \"negative\": \"dpad_left\",\n            \"positive\": \"dpad_right\"\n          }\n        }\n      ]\n    },\n    {\n      \"actionId\": \"2cb70c262f28ab66\",\n      \"name\": \"jump\",\n      \"valueType\": \"bool\",\n      \"displayName\": \"Jump\",\n      \"bindings\": [\n        {\n          \"device\": \"keyboard\",\n          \"physicalKey\": \"space\"\n        },\n        {\n          \"device\": \"gamepad\",\n          \"control\": \"face_south\"\n        }\n      ]\n    },\n    {\n      \"actionId\": \"302f813f89c1849d\",\n      \"name\": \"aim\",\n      \"valueType\": \"axis2d\",\n      \"displayName\": \"Aim\",\n      \"bindings\": [\n        {\n          \"device\": \"keyboard\",\n          \"quad\": {\n            \"up\": \"arrow_up\",\n            \"down\": \"arrow_down\",\n            \"left\": \"arrow_left\",\n            \"right\": \"arrow_right\"\n          }\n        },\n        {\n          \"device\": \"gamepad\",\n          \"control\": \"stick_right\"\n        }\n      ]\n    },\n    {\n      \"actionId\": \"d1e5c72fda17a16f\",\n      \"name\": \"fire\",\n      \"valueType\": \"bool\",\n      \"displayName\": \"Fire\",\n      \"bindings\": [\n        {\n          \"device\": \"keyboard\",\n          \"physicalKey\": \"key_f\"\n        },\n        {\n          \"device\": \"mouse\",\n          \"control\": \"left\"\n        },\n        {\n          \"device\": \"gamepad\",\n          \"control\": \"trigger_right\"\n        }\n      ]\n    }\n  ],\n  \"contexts\": [\n    {\n      \"contextId\": \"a9b081ffcca09e02\",\n      \"name\": \"running\",\n      \"actions\": [\n        \"run\",\n        \"jump\",\n        \"aim\",\n        \"fire\"\n      ]\n    }\n  ]\n}\n"},{"path":"runners.mixer","text":"{\n  \"kind\": \"audio.mixer\",\n  \"formatVersion\": 1,\n  \"master\": {\n    \"busId\": \"b64c164e5d653e5c\",\n    \"name\": \"master\",\n    \"role\": \"master\",\n    \"effects\": [\n      {\n        \"type\": \"rawframe/dynamics@1\",\n        \"processor\": \"limiter\",\n        \"threshold\": -1,\n        \"attack\": 0.001\n      }\n    ],\n    \"children\": [\n      {\n        \"busId\": \"691c5abeb88d55ee\",\n        \"name\": \"effects\",\n        \"role\": \"sfx\",\n        \"volume\": -6,\n        \"sends\": [\n          {\n            \"target\": \"f9b4b46dabadb452\",\n            \"level\": -12\n          }\n        ]\n      },\n      {\n        \"busId\": \"f9b4b46dabadb452\",\n        \"name\": \"room\",\n        \"effects\": [\n          {\n            \"type\": \"rawframe/reverb@1\",\n            \"decay\": 1.2,\n            \"mix\": 1\n          }\n        ]\n      }\n    ]\n  },\n  \"concurrency\": [\n    {\n      \"name\": \"shots\",\n      \"maximumInstances\": 8\n    },\n    {\n      \"name\": \"jumps\",\n      \"maximumInstances\": 4\n    }\n  ]\n}\n"},{"path":"shot.sound","text":"{\n  \"kind\": \"audio.sound\",\n  \"formatVersion\": 1,\n  \"variants\": [\n    {\n      \"resource\": \"0ef1a81f70a113a696a0f55dabdfc157\"\n    }\n  ],\n  \"pitch\": {\n    \"minimum\": 0.875,\n    \"maximum\": 1.125\n  },\n  \"bus\": \"691c5abeb88d55ee\",\n  \"concurrency\": \"shots\",\n  \"attenuation\": {\n    \"minimumDistance\": 2,\n    \"maximumDistance\": 30,\n    \"falloff\": \"linear\"\n  }\n}\n"}],"formatVersion":5,"kind":"game.description","meshes":[],"programs":[{"entry":"runners.kest","path":"runners.kest","sources":"f9f0181057571ecd398d86d2c34a641f"},{"entry":"sample.kest","path":"sample.kest","sources":"f9f0181057571ecd398d86d2c34a641f"}],"scenes":[{"path":"hall.scene","scene":"fd3a48dd33db10fae01e4d65d993d8f3"},{"path":"level.scene","scene":"52771075251e7361deaecf4939c72e56"}],"text":"# The sample platformer: players are characters running and jumping about a\n# level of platforms and slopes and shooting at each other, where the shooter\n# saw the others; a runner hit is told so and counts it. Everything a player does moves no dynamic body, so a client\n# predicts its own runner exactly; each client is sent what is within 30\n# meters and sees the others between states.\nprogram runners.kest\nphysics2d gravity 0 -10 substeps 4\n\ncollision class runner 2ebcd16c10c5f6a4\n\ncomponent 6b05cdb4-0683-437a-aaac-7ad990b2ddb4 runners.stick Stick\ncomponent f6453556-fcdd-46e8-9208-866fade389cf runners.score Score\ncomponent 4a1a3d29-28e9-46fe-aae0-6bb3576ca9b3 runners.hit Hit\ncomponent 5f3691c6-292c-4054-b868-142fe8a4448f runners.emitter Emitter\ncomponent 8c4e2a17-5b90-4d3f-a6e8-1f7c9d0b2e53 runners.age Age\n# No entity holds a penalty: it is what the penalty service is asked about.\ncomponent 3d8b6f21-7c4e-4a95-b0d3-e6f1a2c95b78 runners.penalty Penalty\n\nsystem runners.join simulation join write rawframe.physics2d.body write rawframe.physics2d.pose write rawframe.physics2d.character with runners.stick random spawn before rawframe.physics2d.step\nsystem runners.run simulation run read runners.stick read rawframe.physics2d.character write rawframe.physics2d.velocity entities before rawframe.physics2d.step predicted emits jump\nsystem runners.shoot simulation shoot read runners.stick read rawframe.physics2d.pose read rawframe.replication.perception write runners.score write runners.emitter before rawframe.physics2d.step\nsystem runners.hurt simulation hurt write runners.score read runners.hit entities\nsystem runners.age simulation age write runners.age\n\n# A jump is a presentation effect the runner predicts: its player hears it\n# at once, and once (D219), as jump.sound (D220).\neffect jump predicted sound 57164ad59d5b6a23\n\n# The level (level.scene): the ground, eighty meters wide, walls at its\n# ends, three platforms to jump up to, slopes of 20 degrees at both ends,\n# and one of 55 too steep to stand on.\nscene level.scene\n\n# The hall (hall.scene): one persistent entity that keeps how long the level\n# has been played. A server with `save.directory` keeps it between runs.\nscene hall.scene\nsave hall runners.age\n# Each player keeps their score between visits, under the session they ask\n# for.\nsave player runner runners.score\n\n# Anyone may mod it. A mod adds timers, entities holding runners.age that the\n# age system counts up as it does the hall's (runners-timers is one), and\n# handles hits: right after hurt, over each runner hit, it may change the\n# runner's score (runners-sting is one). One mod may also say what a hit\n# costs: hurt asks the penalty service, which answers one taken unless a\n# mod provides it (runners-penalty is one). And one mod may replace how the\n# hall and every timer age (runners-swift is one).\nmods open\nmodapi runners 1\nextension timers data runners.age multi\nextension hits event runners.hit after runners.hurt write runners.score multi\nextension penalty service runners.penalty exclusive\n# When more than one mod provides the penalty, runners-penalty's is kept and\n# the others' are set aside.\nprefer penalty rawframe/runners-penalty\nextension aging replacement runners.age exclusive\n\nreplicate rawframe.physics2d.body rawframe.physics2d.pose rawframe.physics2d.velocity rawframe.physics2d.character runners.stick runners.score runners.emitter\nplayer runners.stick runners.score runners.emitter rawframe.physics2d.body rawframe.physics2d.pose rawframe.physics2d.velocity rawframe.physics2d.character rawframe.replication.perception\ninput runners.stick perceived\n# A client makes its stick from its player's actions (runners.actions) with\n# sample.kest; bots press the same keys and buttons.\nactions runners.actions\nsample sample.kest sample\ninterest rawframe.physics2d.pose x y within 30\ninterpolate rawframe.physics2d.pose\npredict rawframe.physics2d.body rawframe.physics2d.pose rawframe.physics2d.velocity rawframe.physics2d.character runners.stick\n\n# Each shot sounds from the runner that fired it (runners.mixer, shot.sound);\n# clients hear them, a server carries only the counts. A jump sounds from\n# the runner that jumped, heard by its own player only.\nmixer runners.mixer\nsound 950e09337d03de69 shot.sound\nsound 57164ad59d5b6a23 jump.sound\n\n# What a client shows: the HUD's words in English and Turkish (hud.strings,\n# hud.tr.translations), English unless the player asks otherwise. A server\n# never reads them.\ntext hud.strings\ntext hud.tr.translations\nlocale en\n","texts":[{"document":"aefdab1e47c086ddf189f56bbb92c4f0","path":"hud.strings"},{"document":"0210c143de7237f56d9195d29013927c","path":"hud.tr.translations"}]}