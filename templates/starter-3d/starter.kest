module starter

// The starter game (D780): each player a box it moves about a ground with
// its stick, the server moving it and keeping it on the ground; a client
// draws each box and the ground where they are, seen from above the
// ground's near edge. A new game made from it starts here.
//
// And its scene's parts (D917): every body a part drawn as its shape, in
// its paint where it has one, every lamp a light where its pose is, and a
// sun over all of it, so what an author places in an editor shows.

import controls
import rawframe.model
import rawframe.physics3d
import rawframe.world

// How far a box moves in a tick at a full stick, in meters.
const SPEED: f64 = 0.1

// A box's half size, and its color (0xRRGGBBAA).
const HALF: f32 = 0.5
const BOX_COLOR: u32 = 0xe8743bff

// A player's box: where it stands on the ground.
struct Mover {
    x: f64
    z: f64
}

// The ground: a square `side` meters each way, centered on the World's
// origin, its top at height nought.
struct Ground {
    side: f32
}

// A part's paint: its color, and its material where it names one (D917).
struct Paint {
    color: u32
    material: u64
}

// A part's color where it has no paint.
const PART_COLOR: u32 = 0xb8bcc4ff

extern fn Paint.has(entity: world.Entity) -> bool
extern fn Paint.get(entity: world.Entity) -> Paint

// The ground's entities and each one's ground, which the move system looks
// up (its `lookup` in starter.game).
extern fn Ground.count() -> i32
extern fn Ground.entity(index: i32) -> world.Entity
extern fn Ground.get(entity: world.Entity) -> Ground

fn held(at: f64, edge: f64) -> f64 {
    if at > edge {
        return edge
    }
    if at < -edge {
        return -edge
    }
    return at
}

// Each tick, every player's box moves as its stick asks, no farther from
// the middle than the ground's half side, less the box's own half, or a
// ten-meter ground's without one.
fn move(count: i32, sticks: [controls.Stick], movers: [Mover]) {
    let most = 5.0 - f64(HALF)
    if Ground.count() > 0 {
        most = f64(Ground.get(Ground.entity(0)).side) * 0.5 - f64(HALF)
    }
    let i = 0
    while i < count {
        movers[i].x = held(movers[i].x + f64(sticks[i].x) * SPEED, most)
        movers[i].z = held(movers[i].z + f64(sticks[i].z) * SPEED, most)
        i = i + 1
    }
}

// A client draws each box where it stands, on the ground.
fn dress(count: i32, movers: [Mover], looks: [model.Model], spots: [model.Placed]) {
    let i = 0
    while i < count {
        looks[i] = model.Model(model.BOX, HALF, HALF, HALF, BOX_COLOR, u64(0), 0.0)
        spots[i] = model.Placed(true, movers[i].x, f64(HALF), movers[i].z)
        i = i + 1
    }
}

// The eye above the ground's near edge, looking along -Z and down at it.
fn frame(count: i32, views: [model.Camera]) {
    let i = 0
    while i < count {
        views[i] = model.Camera(0.0, 12.0, 14.0, 0.0, -0.7, 1.0, 0.1, 15.0, u32(0), model.FIXED)
        i = i + 1
    }
}

// Each part drawn as its body's shape, its size the body's, in its paint.
fn dressPart(count: i32, bodies: [physics3d.Body3D], looks: [model.Model], entities: [world.Entity]) {
    let i = 0
    while i < count {
        let b = bodies[i]
        let look = model.Model(model.BOX, b.width, b.height, b.depth, PART_COLOR, u64(0), 0.0)
        if b.shape == physics3d.SPHERE {
            look = model.Model(model.SPHERE, b.width, b.width, b.width, PART_COLOR, u64(0), 0.0)
        }
        if b.shape == physics3d.CAPSULE {
            look = model.Model(model.CAPSULE, b.width, (b.height + b.width) * 0.5, b.width, PART_COLOR, u64(0), 0.0)
        }
        if b.shape == physics3d.CYLINDER {
            look = model.Model(model.CYLINDER, b.width, b.height, b.width, PART_COLOR, u64(0), 0.0)
        }
        if Paint.has(entities[i]) {
            let paint = Paint.get(entities[i])
            look.color = paint.color
            look.material = paint.material
        }
        looks[i] = look
        i = i + 1
    }
}

// A small bulb where each lamp hangs, its light's color.
fn bulb(count: i32, lamps: [model.PointLight], looks: [model.Model]) {
    let i = 0
    while i < count {
        looks[i] = model.Model(model.SPHERE, 0.12, 0.12, 0.12, lamps[i].color, u64(0), 0.0)
        i = i + 1
    }
}

// The sun and the sky as the scene keeps them, which the renderer reads as
// they are: named here so the program lays their types out for the scene
// (a type no function names is not laid out).
fn daylight(suns: [model.Sun], skies: [model.Sky]) -> i32 {
    return 0
}
