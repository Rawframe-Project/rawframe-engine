module std.vec

import std.math

// What is built on the language's `vec2`, `vec3` and `vec4`. The arithmetic is
// the language's -- `a + b`, `v * k` -- a component at a time; what is here is
// what is made of it: a dot product, a length, a distance, a direction. Every
// one is one of those operations after another, so it answers the same bits in
// the machine and in a release, and each that asks nothing of the host is
// `deterministic`. See D1250 and D1251.

fn dot(a: vec2, b: vec2) -> f32 no.alloc no.host deterministic {
    return a.x * b.x + a.y * b.y
}

fn dot(a: vec3, b: vec3) -> f32 no.alloc no.host deterministic {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn dot(a: vec4, b: vec4) -> f32 no.alloc no.host deterministic {
    return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
}

// The one that costs nothing, which is the one a frame budget reaches for:
// comparing two of these orders the same way comparing their lengths does,
// without the square root. What it hands back is a square, so it runs off the
// end of the width where a square does — the square of 1e20 is infinity — and
// comparing works up to the size where the squares stop fitting. `length` is
// the one that answers for every vector this width holds an answer for.
fn lengthSquared(v: vec2) -> f32 no.alloc no.host deterministic {
    return dot(v, v)
}

fn lengthSquared(v: vec3) -> f32 no.alloc no.host deterministic {
    return dot(v, v)
}

fn lengthSquared(v: vec4) -> f32 no.alloc no.host deterministic {
    return dot(v, v)
}

// The square root is the host's, declared by `std.math` and provided by
// whatever the program runs against.
//
// Divided by its largest component first, the way `direction` is and for the
// same reason: the square of a vector runs off the end of an `f32` long before
// the vector does. The length of (1e20, 1e20) is 1.41e20, which this width
// holds perfectly well, and squaring first answered with infinity; at the
// other end the length of (1e-21, 1e-21) came back a part in five thousand
// out, because the squares landed among the numbers an `f32` keeps badly.
//
// A largest component that is not a number is the answer itself: the length of
// a vector with an infinite component is infinite, and dividing by it would
// make that nothing rather than everything. See D383.
fn length(v: vec2) -> f32 no.alloc deterministic {
    let most = math.max(math.abs(v.x), math.abs(v.y))
    if most == 0.0 || !math.isNumber(most) {
        return most
    }
    return most * math.sqrt(lengthSquared(v / most))
}

fn length(v: vec3) -> f32 no.alloc deterministic {
    let most = math.max(math.max(math.abs(v.x), math.abs(v.y)), math.abs(v.z))
    if most == 0.0 || !math.isNumber(most) {
        return most
    }
    return most * math.sqrt(lengthSquared(v / most))
}

fn length(v: vec4) -> f32 no.alloc deterministic {
    let most = math.max(
        math.max(math.abs(v.x), math.abs(v.y)),
        math.max(math.abs(v.z), math.abs(v.w))
    )
    if most == 0.0 || !math.isNumber(most) {
        return most
    }
    return most * math.sqrt(lengthSquared(v / most))
}

// And the one that costs nothing between two points, which is the question a
// frame actually asks: what is nearest, and is it inside a radius. Both of
// those order the same way without the square root, and `lengthSquared` was
// here for that reason while the two-point form of it was not.
fn distanceSquared(a: vec2, b: vec2) -> f32 no.alloc no.host deterministic {
    return lengthSquared(a - b)
}

fn distanceSquared(a: vec3, b: vec3) -> f32 no.alloc no.host deterministic {
    return lengthSquared(a - b)
}

fn distanceSquared(a: vec4, b: vec4) -> f32 no.alloc no.host deterministic {
    return lengthSquared(a - b)
}

fn distance(a: vec2, b: vec2) -> f32 no.alloc deterministic {
    return length(a - b)
}

fn distance(a: vec3, b: vec3) -> f32 no.alloc deterministic {
    return length(a - b)
}

fn distance(a: vec4, b: vec4) -> f32 no.alloc deterministic {
    return length(a - b)
}

// A vector of nought length points nowhere, and there is no direction to
// give back. That is a question with no answer rather than a zero to return
// quietly, so it is an optional (D013).
//
// Divided by its largest component before anything is squared, because
// squaring is where a direction gets lost: a vector of 1e20s squares to
// infinity and came back as (0, 0), which is not a direction and does not say
// so, and a vector of 1e-21s squares into what an `f32` keeps badly and came
// back a thousandth short of a length of one. Dividing first puts every
// component between -1 and 1 with one of them at 1, so what is squared is
// between 1 and 3 whatever it was handed. See D382.
fn direction(v: vec2) -> vec2? no.alloc deterministic {
    let most = math.max(math.abs(v.x), math.abs(v.y))
    if most == 0.0 {
        return none
    }
    let even = v / most
    // The square root of the square rather than `length`, which would divide
    // by the largest component again: that has been done, and it is 1.
    let size = math.sqrt(lengthSquared(even))
    // Which can only fail to be a number if one of the components was not
    // one: infinity over infinity is not a number, and neither is anything
    // that was already not one.
    if !math.isNumber(size) {
        return none
    }
    return even * (1.0 / size)
}

fn direction(v: vec3) -> vec3? no.alloc deterministic {
    let most = math.max(math.max(math.abs(v.x), math.abs(v.y)), math.abs(v.z))
    if most == 0.0 {
        return none
    }
    let even = v / most
    let size = math.sqrt(lengthSquared(even))
    if !math.isNumber(size) {
        return none
    }
    return even * (1.0 / size)
}

fn direction(v: vec4) -> vec4? no.alloc deterministic {
    let most = math.max(
        math.max(math.abs(v.x), math.abs(v.y)),
        math.max(math.abs(v.z), math.abs(v.w))
    )
    if most == 0.0 {
        return none
    }
    let even = v / most
    let size = math.sqrt(lengthSquared(even))
    if !math.isNumber(size) {
        return none
    }
    return even * (1.0 / size)
}

fn lerp(a: vec2, b: vec2, amount: f32) -> vec2 no.alloc no.host deterministic {
    return a + (b - a) * amount
}

fn lerp(a: vec3, b: vec3, amount: f32) -> vec3 no.alloc no.host deterministic {
    return a + (b - a) * amount
}

fn lerp(a: vec4, b: vec4, amount: f32) -> vec4 no.alloc no.host deterministic {
    return a + (b - a) * amount
}

// Perpendicular in two, and the one perpendicular to both in three.
fn perpendicular(v: vec2) -> vec2 no.alloc no.host deterministic {
    return vec2(0.0 - v.y, v.x)
}

fn cross(a: vec3, b: vec3) -> vec3 no.alloc no.host deterministic {
    return vec3(
        a.y * b.z - a.z * b.y,
        a.z * b.x - a.x * b.z,
        a.x * b.y - a.y * b.x
    )
}

// A cross in two dimensions is not a vector: what is perpendicular to both is
// out of the plane, and the whole of it is the one number saying how far. That
// number is the `z` the three-dimensional one gives back, and what a program
// reads off it is which side of `a` the vector `b` is on — positive one way,
// negative the other, and nought when they lie along each other. It is `dot`
// with one of them turned a quarter, which is the other thing this module
// gives for two dimensions and did not put together.
fn cross(a: vec2, b: vec2) -> f32 no.alloc no.host deterministic {
    return a.x * b.y - a.y * b.x
}
