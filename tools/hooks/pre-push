#!/usr/bin/env bash
# Runs the changed tier before every push. Install once with:
#   git config core.hooksPath tools/hooks
# Inside the Rawframe workspace the check takes a slot of the workspace's
# heavy-job wrapper, as every large build there does: in a fresh checkout
# or worktree, or after a change that rebuilds much of the tree, the
# changed tier builds the whole of clang-development. On Windows it runs on
# Linux, in the workspace's WSL distribution (tools/linux.sh).
root="$(git rev-parse --show-toplevel)"
workspace=""
dir=$root
while [ "$dir" != "$(dirname "$dir")" ]; do
    dir=$(dirname "$dir")
    if [ -f "$dir/tools/heavy.sh" ] && [ -f "$dir/tools/linux.sh" ]; then
        workspace=$dir
        break
    fi
done
[ -n "$workspace" ] || exec "$root/tools/check.sh" changed
case "$(uname -s)" in
MINGW* | MSYS* | CYGWIN*) exec "$workspace/tools/heavy.sh" "$workspace/tools/linux.sh" tools/check.sh changed ;;
*) exec "$workspace/tools/heavy.sh" "$root/tools/check.sh" changed ;;
esac
