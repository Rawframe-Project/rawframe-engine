# ThreadSanitizer suppressions for every test of a thread build (D428), set
# by the root CMakeLists.txt. Each is a library built without
# ThreadSanitizer, which cannot see how it orders its own threads, and is
# that library's to check, not the engine's.
#
# The render cluster's (D278): Mesa's software Vulkan driver runs its
# rasterizer on threads of its own and compiles shaders with LLVM; Maul
# RHI's own suite suppresses the same.
called_from_lib:libvulkan_lvp.so
called_from_lib:libLLVM
# The window's system libraries: libxcb (the X connection) and libdbus (the
# desktop's settings) take and release their own locks inside themselves,
# where ThreadSanitizer sees only half, and it reports inversions, a double
# lock, and a race within one thread's calls (D396).
called_from_lib:libxcb.so
called_from_lib:libdbus-1.so
# One of libdbus's own unlocks reaches ThreadSanitizer from a tail call,
# as though Maul Window's caller made it, after the lock it pairs with was
# ignored inside libdbus; the mutex is libdbus's, reached through Maul
# Window's bus calls (linux_bus.c), which take no lock of their own.
mutex:mwinBus*
# MsQuic and OpenSSL, built by tools/build_quic.sh as Release libraries and
# linked in: a binding's lock destroyed after its worker last took it, the
# reference released first by atomics ThreadSanitizer cannot see; and
# OpenSSL's hash table, read without a lock by design (RCU) as another
# thread inserts under one.
race:QuicBindingUninitialize
race:ossl_ht_get
